@model Phineas.Models.ViewModels.Account.UserSummaryViewModel
@{ ViewData["Title"] = "Espace administrateur"; }

<partial name="_LoginConfirmation" model="Model" />

<div class="row g-3 mt-2">
    <div class="col-md-6">
        <a class="card admin-tuile h-100" asp-controller="Concessions" asp-action="Index">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-buildings fs-1 text-primary"></i>
                <div>
                    <div class="fw-semibold fs-5">Concessions</div>
                    <div class="text-muted small">Créer, modifier et suspendre les concessions.</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a class="card admin-tuile h-100" asp-controller="Utilisateurs" asp-action="Index">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-people fs-1 text-primary"></i>
                <div>
                    <div class="fw-semibold fs-5">Personnel</div>
                    <div class="text-muted small">Directeurs, conseillers et mécaniciens de chaque concession.</div>
                </div>
            </div>
        </a>
    </div>
</div>
