@using Phineas.Models.Constants
@using Phineas.Services.Account
@{
    var fullName = User.FindFirst(AppClaims.FullName)?.Value ?? User.Identity?.Name ?? "";
    var dealershipName = User.FindFirst(AppClaims.DealershipName)?.Value;
    var roleLabel = AppRoles.Label(AppRoles.Of(User));
    var initials = string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Phineas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/phineas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mascot.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-body" data-boulon-dock>
    <header class="app-topbar">
        <div class="app-container d-flex align-items-center gap-3">
            <a class="brand brand-dark" asp-controller="Account" asp-action="Home"><span class="brand-mark">P</span><span class="d-none d-sm-inline">Phineas</span></a>

            @if (dealershipName is not null)
            {
                <span class="tenant-pill"><i class="bi bi-buildings"></i><span class="text-truncate">@dealershipName</span></span>
            }

            @if (User.IsInRole(AppRoles.SystemAdmin))
            {
                <nav class="admin-nav d-flex gap-1">
                    <a asp-controller="Concessions" asp-action="Index"><i class="bi bi-buildings"></i><span class="d-none d-md-inline">Concessions</span></a>
                    <a asp-controller="Utilisateurs" asp-action="Index"><i class="bi bi-people"></i><span class="d-none d-md-inline">Personnel</span></a>
                </nav>
            }

            <div class="ms-auto d-flex align-items-center gap-2 gap-sm-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="text-end lh-sm d-none d-md-block">
                        <div class="fw-semibold">@fullName</div>
                        <div class="small text-muted">@roleLabel</div>
                    </div>
                    <span class="avatar" title="@fullName">@initials</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-ghost btn-sm"><i class="bi bi-box-arrow-right"></i><span class="d-none d-sm-inline ms-1">Se déconnecter</span></button>
                    </form>
                }
                else
                {
                    <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">Se connecter</a>
                }
            </div>
        </div>
    </header>

    <main class="app-container app-main">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/mascot.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
