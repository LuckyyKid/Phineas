@using Phineas.Models.Constants
@model Phineas.Models.ViewModels.Account.UserSummaryViewModel
<div class="confirm-card">
    <div class="confirm-head">
        <span class="confirm-check"><i class="bi bi-check-lg"></i></span>
        <div>
            <h1>Bonjour @Model.FirstName!</h1>
            <p class="mb-0">Connexion réussie. Vous êtes dans l'espace <strong>@Model.RoleLabel</strong>.</p>
        </div>
    </div>
    <dl class="confirm-details">
        <div><dt>Nom</dt><dd>@Model.FullName</dd></div>
        <div><dt>Courriel</dt><dd>@Model.Email</dd></div>
        <div><dt>Rôle (AspNetUserRoles)</dt><dd><code>@Model.Role</code></dd></div>
        <div><dt>Concession</dt><dd>@(Model.DealershipName ?? "Toute la plateforme")</dd></div>
        <div><dt>Dernière connexion</dt><dd>@(Model.LastLoginAt?.ToLocalTime().ToString("d MMMM yyyy, HH:mm", new System.Globalization.CultureInfo("fr-CA")) ?? "—")</dd></div>
    </dl>
</div>

<div class="card mt-4">
    <div class="card-header"><span><i class="bi bi-shield-lock me-2"></i>Tester les accès</span></div>
    <div class="card-body">
        <p class="text-muted small mb-3">Ouvrez l'espace d'un autre rôle : vous devriez voir « Accès refusé ».</p>
        <div class="space-grid">
            @foreach (var s in AppRoles.Spaces)
            {
                var mine = s.Role == Model.Role;
                <a class="space-link @(mine ? "is-mine" : "")" asp-controller="@s.Controller" asp-action="Index">
                    <i class="bi @s.Icon"></i>
                    <span>
                        <strong>@AppRoles.Label(s.Role)</strong>
                        <small>@(mine ? "Votre espace" : "Devrait être refusé")</small>
                    </span>
                </a>
            }
        </div>
    </div>
</div>
