@* En-tête des accueils administrateur, directeur et mécanicien : même forme que l'accueil vendeur
   (date, « Bonjour Prénom », phrase de résumé), suivie des informations du compte connecté. *@
@using Phineas.Models.Constants
@using Phineas.Models.ViewModels.Conseiller
@model Phineas.Models.ViewModels.Account.UserSummaryViewModel
@{
    var fr = new System.Globalization.CultureInfo("fr-CA");
    var maintenant = DateTime.Now;
    var derniereConnexion = Model.LastLoginAt?.ToLocalTime().ToString("d MMMM, HH:mm", fr) ?? "première fois";
}
<header class="ph-head">
    <div>
        <p class="ph-label">@FormatVente.DateDuJour(maintenant)</p>
        <h1 class="ph-hello">Bonjour @Model.FirstName</h1>
        <p class="ph-resume">Voici votre espace @Model.RoleLabel.ToLower(fr). Tout ce dont vous avez besoin aujourd’hui est ici.</p>
        <div class="es-faits">
            <span class="es-fait"><i class="bi bi-buildings" aria-hidden="true"></i>@(Model.DealershipName ?? "Toute la plateforme")</span>
            <span class="es-fait"><i class="bi bi-envelope" aria-hidden="true"></i>@Model.Email</span>
            <span class="es-fait"><i class="bi bi-clock-history" aria-hidden="true"></i>Dernière connexion : @derniereConnexion</span>
        </div>
    </div>
</header>
