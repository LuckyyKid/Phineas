@if (TempData["Succes"] is string succes)
{
    <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-check-circle"></i><span>@succes</span>
    </div>
}
@if (TempData["Erreur"] is string erreur)
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle"></i><span>@erreur</span>
    </div>
}
@if (TempData["MotDePasseTemporaire"] is string motDePasse)
{
    <div class="alert alert-warning" role="alert">
        <div class="fw-semibold mb-1"><i class="bi bi-key me-1"></i>Mot de passe temporaire @(TempData["MotDePassePour"] is string pour ? $"pour {pour}" : "")</div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <code id="mdp-temporaire" class="fs-5 px-2 py-1 bg-white rounded border">@motDePasse</code>
            <button type="button" class="btn btn-sm btn-outline-dark" id="copier-mdp">
                <i class="bi bi-clipboard"></i> Copier
            </button>
        </div>
        <div class="small mt-2">Transmettez-le à la personne : elle devra le changer à sa première connexion. Il ne sera plus affiché après cette page.</div>
    </div>
    <script>
        document.getElementById('copier-mdp').addEventListener('click', function () {
            navigator.clipboard.writeText(document.getElementById('mdp-temporaire').textContent.trim());
            this.innerHTML = '<i class="bi bi-check2"></i> Copié';
        });
    </script>
}
