<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="view-transition" content="same-origin" />
    <title>@ViewData["Title"] · Phineas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/phineas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mascot.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lumiere.css" asp-append-version="true" />
</head>
<body>
    <div class="lm-auth">
        <section class="lm-auth-main">
            <div class="d-flex align-items-center justify-content-between">
                <a class="lm-logo" asp-controller="Home" asp-action="Index"><partial name="_Logo" />phineas</a>
                <a class="btn btn-ghost btn-sm" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Accueil</a>
            </div>
            <div class="lm-auth-form lm-enter">
                @RenderBody()
            </div>
            <p class="lm-auth-foot mb-0"><i class="bi bi-shield-check me-1"></i>Conforme à la Loi 25 sur la protection des renseignements personnels.</p>
        </section>

        <section class="lm-auth-aside" aria-label="Aperçu de Phineas">
            <div class="d-flex flex-column gap-3">
                <span class="lm-eyebrow"><i class="bi bi-broadcast"></i>Suivi en direct avec SignalR</span>
                <h2>Toute votre concession, dans une seule fenêtre.</h2>
                <ul class="lm-points">
                    <li><i class="bi bi-qr-code-scan"></i>Suivi par code QR</li>
                    <li><i class="bi bi-lightning-charge"></i>Tableau en temps réel</li>
                    <li><i class="bi bi-shield-lock"></i>Dossiers F&amp;A protégés</li>
                    <li><i class="bi bi-stars"></i>Annonces par IA</li>
                </ul>
            </div>

            <div class="lm-stage" data-parallax aria-hidden="true">
                <div class="lm-stage-inner">
                    <div class="lm-pane base">
                        <div class="d-flex align-items-center gap-2">
                            <strong style="font-family: var(--lm-display); font-size: 14px">Parcours des véhicules</strong>
                            <span class="lm-live" style="font-size: 10px; padding: 3px 8px">Direct</span>
                        </div>
                        <div class="lm-mini-cols">
                            <div class="lm-mini-col"><b><i style="background:#94A3B8"></i>Reçu</b><div class="lm-mini-card">Ford F-150<small>STK-0027</small></div><div class="lm-mini-card">Kia Telluride<small>STK-0049</small></div></div>
                            <div class="lm-mini-col"><b><i style="background:#3B82F6"></i>Inspection</b><div class="lm-mini-card hot">Honda Accord<small>STK-0042</small></div><div class="lm-mini-card">Mazda CX-5<small>STK-0046</small></div></div>
                            <div class="lm-mini-col"><b><i style="background:#8B5CF6"></i>Nettoyage</b><div class="lm-mini-card">VW Golf GTI<small>STK-0040</small></div></div>
                            <div class="lm-mini-col"><b><i style="background:#10B981"></i>Prêt</b><div class="lm-mini-card">Tesla Model 3<small>STK-0031</small></div><div class="lm-mini-card">Honda CR-V<small>STK-0033</small></div></div>
                        </div>
                    </div>
                    <div class="lm-pane toast">
                        <span class="lm-avatar" style="background:#ECFEFF;color:#0E7490">LB</span>
                        <span><strong>Luc B.</strong> a terminé l’inspection<br><small class="text-muted">Honda Accord · à l’instant</small></span>
                    </div>
                    <div class="lm-pane qr">
                        <div class="lm-qr-box"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
                        <span style="font-family: var(--lm-mono)">STK-0042</span>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/lumiere.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
