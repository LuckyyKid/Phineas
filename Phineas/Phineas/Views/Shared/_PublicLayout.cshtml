<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="view-transition" content="same-origin" />
    <meta name="description" content="Phineas centralise l'inventaire, le suivi des véhicules par QR, les dossiers de financement et les annonces de votre concession." />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/phineas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mascot.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lumiere.css" asp-append-version="true" />
</head>
<body class="lm-pub">
    <header class="lm-pub-nav">
        <div class="lm-wrap d-flex align-items-center gap-3">
            <a class="lm-logo" asp-controller="Home" asp-action="Index"><partial name="_Logo" />phineas</a>
            <nav class="lm-pub-links d-none d-md-flex" aria-label="Sections">
                <a href="#fonctionnalites">Fonctionnalités</a>
                <a href="#fonctionnement">Fonctionnement</a>
                <a href="#securite">Sécurité</a>
                <a href="#feuille-de-route">Feuille de route</a>
            </nav>
            <div class="ms-auto">
                <a class="btn btn-dark" asp-controller="Account" asp-action="Login">Se connecter</a>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="lm-pub-foot">
        <div class="lm-wrap d-flex flex-wrap justify-content-between align-items-center gap-3">
            <a class="lm-logo" asp-controller="Home" asp-action="Index" style="font-size: 16px"><partial name="_Logo" view-data='new ViewDataDictionary(ViewData) { ["Taille"] = 22 }' />phineas</a>
            <span>Applications Web 3 · Collège de Rosemont</span>
            <span>Conforme à la Loi 25 sur la protection des renseignements personnels.</span>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/mascot.js" asp-append-version="true"></script>
    <script src="~/js/lumiere.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
