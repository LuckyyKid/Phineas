<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Phineas centralise l'inventaire, le suivi des véhicules par QR, les dossiers de financement et les annonces de votre concession." />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/phineas.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mascot.css" asp-append-version="true" />
</head>
<body class="public-body">
    <header class="public-nav">
        <div class="public-container d-flex align-items-center gap-3">
            <a class="brand brand-dark" asp-controller="Home" asp-action="Index"><span class="brand-mark">P</span><span>Phineas</span></a>
            <nav class="d-none d-md-flex gap-4 ms-4">
                <a href="#fonctionnalites">Fonctionnalités</a>
                <a href="#fonctionnement">Fonctionnement</a>
                <a href="#securite">Sécurité</a>
            </nav>
            <div class="ms-auto">
                <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Se connecter</a>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="public-footer">
        <div class="public-container d-flex flex-wrap justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="brand-mark brand-mark-sm">P</span>
                <span>Phineas · Gestion des opérations en concession automobile</span>
            </div>
            <span>Conforme à la Loi 25 sur la protection des renseignements personnels.</span>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/mascot.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
