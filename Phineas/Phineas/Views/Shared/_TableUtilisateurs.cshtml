@model List<EmployeResume>
@{
    var afficherConcession = ViewData["AfficherConcession"] as bool? ?? false;
    var retour = Context.Request.Path + Context.Request.QueryString;
    var culture = System.Globalization.CultureInfo.GetCultureInfo("fr-CA");
}

@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-people fs-1 d-block mb-2"></i>
        Aucune personne pour l'instant.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Personne</th>
                    <th>Rôle</th>
                    @if (afficherConcession) { <th>Concession</th> }
                    <th>Statut</th>
                    <th class="d-none d-lg-table-cell">Dernière connexion</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="@(p.EstActif ? "" : "text-muted")">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar">@p.Initiales</span>
                                <div class="lh-sm">
                                    <div class="fw-semibold">@p.NomComplet</div>
                                    <div class="small text-muted">@p.Email</div>
                                </div>
                            </div>
                        </td>
                        <td>@p.LibelleRole</td>
                        @if (afficherConcession)
                        {
                            <td>
                                @if (p.DealershipId is not null)
                                {
                                    <a asp-controller="Concessions" asp-action="Details" asp-route-id="@p.DealershipId">@p.NomConcession</a>
                                }
                                else
                                {
                                    <span class="text-muted">Plateforme</span>
                                }
                            </td>
                        }
                        <td>
                            @if (!p.EstActif)
                            {
                                <span class="badge text-bg-secondary">Désactivé</span>
                            }
                            else if (p.EstVerrouille)
                            {
                                <span class="badge text-bg-danger">Verrouillé</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Actif</span>
                            }
                            @if (p.DoitChangerMotDePasse)
                            {
                                <span class="badge text-bg-warning">Mot de passe temporaire</span>
                            }
                        </td>
                        <td class="d-none d-lg-table-cell small">
                            @(p.DerniereConnexion?.ToLocalTime().ToString("d MMM yyyy, HH:mm", culture) ?? "Jamais")
                        </td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">Gérer</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Utilisateurs" asp-action="Modifier" asp-route-id="@p.Id">
                                            <i class="bi bi-pencil me-2"></i>Modifier
                                        </a>
                                    </li>
                                    <li>
                                        <form asp-controller="Utilisateurs" asp-action="ReinitialiserMotDePasse" asp-route-id="@p.Id" method="post">
                                            <input type="hidden" name="retour" value="@retour" />
                                            <input type="hidden" name="courriel" value="@p.Email" />
                                            <button type="submit" class="dropdown-item"><i class="bi bi-key me-2"></i>Nouveau mot de passe</button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="Utilisateurs" asp-action="BasculerActivation" asp-route-id="@p.Id" method="post">
                                            <input type="hidden" name="retour" value="@retour" />
                                            <button type="submit" class="dropdown-item">
                                                @if (p.EstActif)
                                                {
                                                    <i class="bi bi-pause-circle me-2"></i><text>Désactiver</text>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-play-circle me-2"></i><text>Réactiver</text>
                                                }
                                            </button>
                                        </form>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Utilisateurs" asp-action="Supprimer" asp-route-id="@p.Id" method="post"
                                              onsubmit="return confirm('Supprimer définitivement ce compte?');">
                                            <input type="hidden" name="retour" value="@retour" />
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Supprimer</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
