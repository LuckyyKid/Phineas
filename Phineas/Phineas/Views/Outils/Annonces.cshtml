@* Page « Studio d'annonces » (maquettes 28 à 31) : liste des annonces et fenêtre « Nouvelle annonce » en 4 étapes.
   Comportement : wwwroot/js/annonces-page.js (textes : annonces-modeles.js ; données : outils-store.js ; pagination : outils-pagination.js).
   Styles : outils.css (jetons og-) et annonces-verre.css (préfixe anv-). *@
@using Phineas.Models.ViewModels.Conseiller
@model OutilsPageViewModel
@{
    ViewData["Title"] = "Studio d'annonces";
    Layout = "~/Views/Conseiller/_LayoutConseiller.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/prospects.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/intelligence.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/outils.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/annonces-verre.css" asp-append-version="true" />
}

<div class="og-page anv-page">

@* Haut propre à cette page : la maquette ne montre ni « Modifiée » ni « Réinitialiser » dans la barre du haut.
   La réinitialisation de la démo reste disponible, discrètement, dans la note du bas. *@
<div class="og-haut">
    <nav class="og-ariane" aria-label="Fil d'Ariane">
        <span>Sales OS</span><i class="bi bi-chevron-right" aria-hidden="true"></i><span aria-current="page">Studio d'annonces</span>
    </nav>
    <div class="og-puces" role="note" title="Données fictives. Rien n'est enregistré en base.">
        <span class="og-chip-demo">Démo</span>
        <span class="og-en-ligne"><span class="og-point-vert" aria-hidden="true"></span>En ligne</span>
    </div>
</div>

<header class="anv-entete">
    <div>
        <p class="anv-label">Outils</p>
        <h1 class="anv-titre">Studio d'annonces</h1>
        <p class="anv-intro">Préparer des annonces exactes à partir de l'inventaire, les relire et les valider avant toute publication.</p>
    </div>
    <div class="anv-entete-boutons">
        <a class="anv-btn-verre" asp-action="Acquisition" asp-route-onglet="publications"><i class="bi bi-megaphone" aria-hidden="true"></i>Publications</a>
        <button type="button" class="anv-btn-sapin" data-an="nouvelle"><i class="bi bi-plus-lg" aria-hidden="true"></i>Nouvelle annonce</button>
    </div>
</header>

<div id="annonces" data-annonce="@Model.AnnonceId" data-vehicule="@Model.VehiculeId">
    <section class="anv-verre anv-module" aria-label="Annonces">
        <div class="anv-outils">
            <div class="anv-recherche">
                <i class="bi bi-search" aria-hidden="true"></i>
                <input type="search" id="f-recherche" placeholder="Référence, véhicule ou titre" aria-label="Rechercher une annonce" autocomplete="off" />
            </div>
            <select class="anv-select" id="f-statut" aria-label="Filtrer par statut">
                <option value="">Tous les statuts</option>
                @foreach (var (cle, libelle) in ReferentielsOutils.StatutsAnnonce)
                {
                    <option value="@cle">@libelle</option>
                }
            </select>
            <select class="anv-select" id="f-canal" aria-label="Filtrer par canal">
                <option value="">Tous les canaux</option>
                @foreach (var (cle, libelle, _) in ReferentielsOutils.Plateformes)
                {
                    <option value="@cle">@libelle</option>
                }
            </select>
            <button type="button" class="anv-lien" data-effacer-filtres hidden>Effacer les filtres</button>
        </div>
        <p class="visually-hidden" id="resultat" aria-live="polite"></p>
        <div class="anv-defile">
            <table class="anv-table" id="table-annonces">
                <thead>
                    <tr>
                        <th scope="col">Annonce</th>
                        <th scope="col">Titre et aperçu</th>
                        <th scope="col">Canal</th>
                        <th scope="col">Modifiée</th>
                        <th scope="col">Statut</th>
                        <th scope="col">Provenance</th>
                    </tr>
                </thead>
                <tbody id="liste-corps"></tbody>
            </table>
        </div>
        <p class="anv-vide" id="etat-vide" hidden>Aucune annonce ne correspond.</p>
        <div class="anv-pied">
            <span id="nb-annonces"></span>
            <div class="og-pagination-zone" data-pagination="liste-corps"></div>
        </div>
    </section>

    <p class="anv-note">
        <i class="bi bi-shield-check" aria-hidden="true"></i>
        <span>
            Aucun générateur d'annonces par IA n'est connecté. Les textes sont composés à partir des seuls champs de la fiche d'inventaire. La validation humaine reste obligatoire, et Phineas ne publie aucune annonce.
            <span class="anv-demo-etat" data-etat-demo hidden>Données de démonstration modifiées.</span>
            <button type="button" class="anv-lien" data-reinitialiser hidden>Réinitialiser la démo</button>
        </span>
    </p>
</div>

</div>

@* Fenêtre « Nouvelle annonce » (et édition d'une annonce existante). Le script la déplace à la fin du <body>
   pour que le voile couvre toute la page, barre latérale comprise. *@
<div class="og-page anv-fenetre-racine" id="fenetre-annonce" hidden>
    <div class="anv-voile" data-fermer-fenetre></div>
    <div class="anv-fenetre" role="dialog" aria-modal="true" aria-labelledby="fenetre-titre" aria-describedby="fenetre-aide">
        <header class="anv-fenetre-tete">
            <div class="anv-fenetre-tete-ligne">
                <div>
                    <h2 class="anv-fenetre-titre" id="fenetre-titre">Nouvelle annonce</h2>
                    <p class="anv-fenetre-aide" id="fenetre-aide"></p>
                </div>
                <button type="button" class="anv-fermer" data-fermer-fenetre aria-label="Fermer la fenêtre"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <ol class="anv-etapes" data-zone="etapes" aria-label="Étapes"></ol>
        </header>

        <div class="anv-fenetre-corps">
            <div class="anv-gauche" data-zone="gauche">
                @* Étape 1 : véhicule *@
                <section data-etape="1">
                    <p class="anv-champ-label">Véhicule de l'inventaire</p>
                    <div class="anv-tuiles anv-tuiles-deux" role="radiogroup" aria-label="Véhicule de l'inventaire" data-zone="tuiles-vehicules"></div>
                </section>

                @* Étape 2 : objectif *@
                <section data-etape="2" hidden>
                    <p class="anv-champ-label">Objectif de l'annonce</p>
                    <div class="anv-tuiles anv-tuiles-deux" role="radiogroup" aria-label="Objectif de l'annonce" data-zone="tuiles-objectifs"></div>
                </section>

                @* Étape 3 : canal et ton *@
                <section data-etape="3" hidden>
                    <p class="anv-champ-label">Canal</p>
                    <div class="anv-tuiles anv-tuiles-trois" role="radiogroup" aria-label="Canal" data-zone="tuiles-canaux"></div>
                    <p class="anv-champ-label anv-champ-label-espace">Ton</p>
                    <div class="anv-tuiles anv-tuiles-trois" role="radiogroup" aria-label="Ton" data-zone="tuiles-styles"></div>
                    <p class="anv-aide-petite"><i class="bi bi-translate" aria-hidden="true"></i>Langue : français. L'anglais et l'espagnol arriveront plus tard.</p>
                </section>

                @* Étape 4 : édition et validation d'une nouvelle annonce *@
                <section data-etape="4" hidden>
                    <label class="anv-champ-label" for="ed-titre">Titre</label>
                    <input class="anv-champ" id="ed-titre" maxlength="120" />
                    <label class="anv-champ-label anv-champ-label-espace" for="ed-description">Texte de l'annonce</label>
                    <textarea class="anv-zone-texte" id="ed-description" rows="6"></textarea>
                    <label class="anv-champ-label anv-champ-label-espace" for="ed-points">Points forts <span class="anv-facultatif">(un par ligne)</span></label>
                    <textarea class="anv-zone-texte" id="ed-points" rows="3"></textarea>
                    <label class="anv-champ-label anv-champ-label-espace" for="ed-appel">Appel à l'action</label>
                    <input class="anv-champ" id="ed-appel" maxlength="160" />
                    <div data-zone="verifier-nouvelle"></div>
                    <label class="anv-relecture">
                        <input class="form-check-input" type="checkbox" id="ed-relu" />
                        <span>J'ai relu l'annonce et vérifié chaque information contre la fiche d'inventaire.</span>
                    </label>
                </section>

                @* Édition d'une annonce existante (ouverte depuis la liste) *@
                <section data-etape="edition" hidden>
                    <label class="anv-champ-label" for="ex-titre">Titre</label>
                    <input class="anv-champ" id="ex-titre" maxlength="120" />
                    <label class="anv-champ-label anv-champ-label-espace" for="ex-description">Texte de l'annonce</label>
                    <textarea class="anv-zone-texte" id="ex-description" rows="6"></textarea>
                    <label class="anv-champ-label anv-champ-label-espace" for="ex-points">Points forts <span class="anv-facultatif">(un par ligne)</span></label>
                    <textarea class="anv-zone-texte" id="ex-points" rows="3"></textarea>
                    <label class="anv-champ-label anv-champ-label-espace" for="ex-appel">Appel à l'action</label>
                    <input class="anv-champ" id="ex-appel" maxlength="160" />
                    <div class="anv-rangee-boutons">
                        <button type="button" class="anv-btn-blanc" data-an="variantes"><i class="bi bi-layout-three-columns" aria-hidden="true"></i>Comparer 3 variantes</button>
                    </div>
                    <div data-zone="variantes"></div>
                    <h3 class="anv-sous-titre">À vérifier avant validation</h3>
                    <ul class="anv-verifier" data-zone="verifier"></ul>
                    <h3 class="anv-sous-titre">Validation</h3>
                    <div data-zone="validation"></div>
                    <h3 class="anv-sous-titre">Historique</h3>
                    <ol class="anv-historique" data-zone="historique"></ol>
                    <div class="og-pagination-zone" data-pagination="historique"></div>
                </section>

                <p class="anv-erreur" data-zone="erreur" role="alert" hidden></p>
            </div>

            <aside class="anv-droite" aria-label="Aperçu de l'annonce">
                <div class="anv-apercu-tete">
                    <span class="anv-label">Aperçu</span>
                    <span class="anv-apercu-canal" data-zone="apercu-canal">Canal à choisir</span>
                </div>
                <article class="anv-apercu" data-zone="apercu"></article>
                <div class="anv-champs-utilises" data-zone="champs-utilises"></div>
                <dl class="anv-inventaire" data-zone="inventaire" hidden></dl>
                <p class="anv-apercu-note">Le texte vient uniquement de la fiche d'inventaire. Aucune IA n'est connectée et Phineas ne publie rien.</p>
            </aside>
        </div>

        <footer class="anv-fenetre-pied">
            <button type="button" class="anv-btn-blanc" data-an="retour">Annuler</button>
            <div class="anv-fenetre-pied-droite">
                <button type="button" class="anv-btn-blanc" data-an="brouillon" hidden>Enregistrer le brouillon</button>
                <button type="button" class="anv-btn-sapin" data-an="avancer">Suivant<i class="bi bi-arrow-right" aria-hidden="true"></i></button>
            </div>
        </footer>
    </div>
</div>

<partial name="~/Views/Intelligence/_DonneesModules.cshtml" model="Model" />

@section Scripts {
    <script src="~/js/prospects-store.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-calcul.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-store.js" asp-append-version="true"></script>
    <script src="~/js/rendezvous-store.js" asp-append-version="true"></script>
    <script src="~/js/transactions-regles.js" asp-append-version="true"></script>
    <script src="~/js/transactions-store.js" asp-append-version="true"></script>
    <script src="~/js/relations-regles.js" asp-append-version="true"></script>
    <script src="~/js/relations-store.js" asp-append-version="true"></script>
    <script src="~/js/annonces-modeles.js" asp-append-version="true"></script>
    <script src="~/js/outils-store.js" asp-append-version="true"></script>
    <script src="~/js/outils-pagination.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-matching.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-regles.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-store.js" asp-append-version="true"></script>
    <script src="~/js/annonces-page.js" asp-append-version="true"></script>
}
