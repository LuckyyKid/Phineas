@using Phineas.Models.ViewModels.Conseiller
@model OutilsPageViewModel
@{
    ViewData["Title"] = "Assistant vendeur";
    Layout = "~/Views/Conseiller/_LayoutConseiller.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/prospects.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/intelligence.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/outils.css" asp-append-version="true" />
}

<div class="og-page">
<partial name="_HautOutils" />

<header class="sv-head">
    <div>
        <h1>Assistant vendeur</h1>
        <p class="text-muted mb-0">Préparer un rendez-vous, comprendre un véhicule, une objection ou une procédure, à partir de vos dossiers.</p>
    </div>
</header>

<div class="ov-simulation" role="note">
    <i class="bi bi-cpu" aria-hidden="true"></i>
    <span><strong>Aucune IA n'est connectée.</strong> Les réponses sont des simulations construites par des modèles déterministes à partir des données de démonstration du dossier choisi. Chaque réponse indique les données utilisées ; ce qui est inconnu reste inconnu.</span>
</div>

<div id="assistant" class="ov-coach" data-mode="@Model.Mode" data-contexte="@Model.ContexteType" data-id="@Model.ContexteId">
    <aside class="ov-coach-cote">
        <section class="card" aria-labelledby="titre-contexte">
            <div class="card-header sv-card-header"><span id="titre-contexte"><i class="bi bi-folder2-open me-2"></i>Contexte</span></div>
            <div class="card-body">
                <label class="form-label" for="ctx-type">Dossier utilisé</label>
                <select class="form-select form-select-sm" id="ctx-type">
                    @foreach (var (cle, libelle) in ReferentielsOutils.Contextes)
                    {
                        <option value="@cle">@libelle</option>
                    }
                </select>
                <label class="form-label mt-2" for="ctx-id">Choix</label>
                <select class="form-select form-select-sm" id="ctx-id" disabled><option value="">—</option></select>
                <h2 class="ia-sous-titre">Informations mises à la disposition de l'assistant</h2>
                <ul class="ia-liste-simple" data-zone="mis-a-disposition"></ul>
            </div>
        </section>
        <section class="card" aria-labelledby="titre-historique">
            <div class="card-header sv-card-header"><span id="titre-historique"><i class="bi bi-clock-history me-2"></i>Historique local</span></div>
            <div class="card-body"><ol class="ov-historique" data-zone="historique"></ol></div>
        </section>
    </aside>

    <section class="card ov-conversation" aria-labelledby="titre-conversation">
        <div class="card-header sv-card-header"><span id="titre-conversation"><i class="bi bi-stars me-2"></i>Conversation</span><span class="badge-soft">Simulation</span></div>
        <div class="ov-modes" role="group" aria-label="Que voulez-vous faire ?">
            @foreach (var (cle, libelle, icone) in ReferentielsOutils.ModesCoach)
            {
                <button type="button" class="sv-chip" data-mode-coach="@cle" aria-pressed="false"><i class="bi @icone me-1" aria-hidden="true"></i>@libelle</button>
            }
        </div>
        <div class="ov-fil" data-zone="fil" aria-live="polite">
            <div class="sv-empty" data-vide><i class="bi bi-chat-square-text"></i><span>Choisissez un dossier et un mode, ou posez une question sur une procédure.</span></div>
        </div>
        <form class="ov-saisie" id="form-coach" novalidate>
            <div class="ov-parametres">
                <select class="form-select form-select-sm" id="p-objection" aria-label="Objection" hidden>
                    <option value="">Choisir l'objection</option>
                    @foreach (var o in ReferentielsOutils.Objections)
                    {
                        <option value="@o.Cle">@o.Libelle</option>
                    }
                </select>
                <select class="form-select form-select-sm" id="p-procedure" aria-label="Procédure" hidden>
                    <option value="">Toutes les procédures</option>
                    @foreach (var p in ReferentielsOutils.Procedures)
                    {
                        <option value="@p.Cle">@p.Libelle</option>
                    }
                </select>
            </div>
            <label class="visually-hidden" for="coach-question">Votre question</label>
            <textarea class="form-control" id="coach-question" rows="2" placeholder="Ex. : Comment ouvrir une transaction ? Quelles informations manquent pour ce rendez-vous ?"></textarea>
            <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Demander</button>
        </form>
    </section>
</div>

</div>

<partial name="~/Views/Intelligence/_DonneesModules.cshtml" model="Model" />

@section Scripts {
    <script src="~/js/prospects-store.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-calcul.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-store.js" asp-append-version="true"></script>
    <script src="~/js/rendezvous-store.js" asp-append-version="true"></script>
    <script src="~/js/transactions-regles.js" asp-append-version="true"></script>
    <script src="~/js/transactions-store.js" asp-append-version="true"></script>
    <script src="~/js/relations-regles.js" asp-append-version="true"></script>
    <script src="~/js/relations-store.js" asp-append-version="true"></script>
    <script src="~/js/annonces-modeles.js" asp-append-version="true"></script>
    <script src="~/js/outils-store.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-matching.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-regles.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-store.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-composants.js" asp-append-version="true"></script>
    <script src="~/js/coach-regles.js" asp-append-version="true"></script>
    <script src="~/js/coach-service.js" asp-append-version="true"></script>
    <script src="~/js/coach-page.js" asp-append-version="true"></script>
}
