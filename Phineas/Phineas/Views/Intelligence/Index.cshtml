@* Centre d'actions (maquette 01-centre-actions) : chiffres du jour, puis une grande carte avec les onglets
   (à traiter, opportunités qui stagnent, reportées, traitées, continuité), les filtres et la liste des actions.
   Données : IntelligenceController.Index. Interactions : wwwroot/js/intelligence-actions.js ;
   lignes d'action et fenêtres : intelligence-composants.js. Styles : intelligence-verre.css. *@
@using Phineas.Models.ViewModels.Conseiller
@model IntelligencePageViewModel
@{
    ViewData["Title"] = "Centre d'actions";
    Layout = "~/Views/Conseiller/_LayoutConseiller.cshtml";
}

@section Styles {
    @* Les anciennes feuilles restent pour les fenêtres (relance, report, historique), créées par intelligence-composants.js. *@
    <link rel="stylesheet" href="~/css/prospects.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rendezvous.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/intelligence.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/intelligence-verre.css" asp-append-version="true" />
}

<div class="iv-page">
    <div class="iv-haut">
        <nav class="iv-ariane" aria-label="Fil d'Ariane">
            <span>Sales OS</span><i class="bi bi-chevron-right" aria-hidden="true"></i><span aria-current="page">Centre d'actions</span>
        </nav>
        @* Remplace le bandeau permanent : l'état et la réinitialisation restent accessibles ici (prospects-store.js). *@
        <div class="iv-puces" role="note" title="Clients, véhicules et montants fictifs. Rien n'est enregistré en base : les ajouts restent dans cet onglet.">
            <span class="iv-chip-demo">Démo</span>
            <span class="iv-demo-etat" data-etat-demo hidden>Modifiée</span>
            <button type="button" class="iv-demo-reset" data-reinitialiser hidden><i class="bi bi-arrow-counterclockwise"></i>Réinitialiser</button>
            <span class="iv-en-ligne"><span class="iv-point-vert" aria-hidden="true"></span>En ligne</span>
        </div>
    </div>

    <header class="iv-entete">
        <div>
            <p class="iv-surtitre">Tous modules confondus</p>
            <h1 class="iv-titre">Centre d'actions</h1>
            <p class="iv-intro">Ce qui demande votre attention. Chaque action est justifiée et reliée à son dossier.</p>
        </div>
        <div class="iv-raccourcis">
            <a class="iv-btn iv-btn-verre" asp-action="Suivis"><i class="bi bi-arrow-repeat"></i>Mes suivis</a>
            <a class="iv-btn iv-btn-verre" asp-action="Vehicules"><i class="bi bi-car-front"></i>Recommandations véhicules</a>
        </div>
    </header>

    <section class="iv-chiffres" aria-label="Résumé de mes actions">
        <div class="iv-verre iv-chiffre"><strong data-compteur="aTraiter">0</strong><span>à traiter</span></div>
        <div class="iv-verre iv-chiffre" title="Urgentes ou élevées"><strong data-compteur="prioritaires">0</strong><span>prioritaires</span></div>
        <div class="iv-verre iv-chiffre"><strong data-compteur="echeance">0</strong><span>échéance sous 24 h</span></div>
        <div class="iv-verre iv-chiffre" title="Échéance dépassée"><strong data-compteur="retard">0</strong><span>en retard<span class="iv-point-rouge" aria-hidden="true"></span></span></div>
        <div class="iv-verre iv-chiffre"><strong data-compteur="terminees">0</strong><span>terminées aujourd'hui</span></div>
    </section>

    <div class="iv-verre iv-centre" id="centre">
        <div class="iv-centre-tete">
            <ul class="nav iv-onglets" role="tablist">
                <li class="nav-item" role="presentation"><button class="nav-link active" id="onglet-file" data-bs-toggle="tab" data-bs-target="#panneau-file" type="button" role="tab" aria-controls="panneau-file" aria-selected="true">À traiter <span class="iv-compte" data-champ="nb-file"></span></button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" id="onglet-surveillance" data-bs-toggle="tab" data-bs-target="#panneau-surveillance" type="button" role="tab" aria-controls="panneau-surveillance" aria-selected="false">Opportunités qui stagnent <span class="iv-compte" data-champ="nb-surveillance"></span></button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" id="onglet-reportees" data-bs-toggle="tab" data-bs-target="#panneau-reportees" type="button" role="tab" aria-controls="panneau-reportees" aria-selected="false">En veille et reportées <span class="iv-compte" data-champ="nb-reportees"></span></button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" id="onglet-traitees" data-bs-toggle="tab" data-bs-target="#panneau-traitees" type="button" role="tab" aria-controls="panneau-traitees" aria-selected="false">Traitées et obsolètes <span class="iv-compte" data-champ="nb-traitees"></span></button></li>
                <li class="nav-item" role="presentation"><button class="nav-link" id="onglet-continuite" data-bs-toggle="tab" data-bs-target="#panneau-continuite" type="button" role="tab" aria-controls="panneau-continuite" aria-selected="false">Continuité <span class="iv-compte" data-champ="nb-continuite"></span></button></li>
            </ul>

            @* Les filtres s'appliquent à l'onglet « À traiter ». *@
            <div class="iv-filtres" data-filtres>
                <div class="iv-recherche">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" id="f-recherche" placeholder="Client, véhicule ou situation" aria-label="Rechercher une action" autocomplete="off" />
                </div>
                <select class="iv-select" id="f-categorie" aria-label="Filtrer par catégorie">
                    <option value="">Catégorie</option>
                    @foreach (var (cle, libelle, _) in ReferentielsIntelligence.Categories)
                    {
                        <option value="@cle">@libelle</option>
                    }
                </select>
                <select class="iv-select" id="f-priorite" aria-label="Filtrer par priorité">
                    <option value="">Priorité</option>
                    @foreach (var (cle, libelle, _) in ReferentielsIntelligence.Priorites)
                    {
                        <option value="@cle">@libelle</option>
                    }
                </select>
                <select class="iv-select" id="f-responsable" aria-label="Filtrer par responsable">
                    <option value="moi">Mes actions</option>
                    <option value="confiees">Confiées à un collègue</option>
                    <option value="">Tous les conseillers</option>
                </select>
                <div class="form-check form-switch iv-interrupteur">
                    <input class="form-check-input" type="checkbox" role="switch" id="f-retard" />
                    <label class="form-check-label" for="f-retard">En retard</label>
                </div>
                <button type="button" class="iv-btn iv-btn-discret" data-effacer-filtres hidden>Effacer les filtres</button>
            </div>
        </div>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="panneau-file" role="tabpanel" aria-labelledby="onglet-file" tabindex="0">
                <p class="visually-hidden" id="resultat" aria-live="polite"></p>
                <div class="iv-actions" id="file"></div>
                <div class="iv-vide" id="file-vide" hidden>
                    <i class="bi bi-check2-circle"></i>
                    <strong data-vide-titre>Aucune action</strong>
                    <span data-vide-texte></span>
                </div>
            </div>

            <div class="tab-pane fade" id="panneau-surveillance" role="tabpanel" aria-labelledby="onglet-surveillance" tabindex="0">
                <p class="iv-intro-panneau"><i class="bi bi-info-circle"></i> Une opportunité inactive n'est pas une preuve de désintérêt : rien n'est classé « perdu » automatiquement. Les seuils sont configurables (règles de démonstration).</p>
                <div class="iv-actions" id="surveillance"></div>
            </div>

            <div class="tab-pane fade" id="panneau-reportees" role="tabpanel" aria-labelledby="onglet-reportees" tabindex="0">
                @* Fonctionnalité 14 : veilles enregistrées en base (dossiers réels) et reports locaux (démonstration), séparés. *@
                <h2 class="iv-sous-titre">En veille, enregistrées dans vos dossiers · <span data-champ="nb-veilles">0</span></h2>
                <p class="iv-intro-panneau"><i class="bi bi-info-circle"></i> Une recommandation en veille n'est pas réalisée : elle revient d'elle-même à la fin de la veille si elle s'applique toujours, ou dès que vous la réactivez.</p>
                <div class="iv-actions" id="veilles"></div>
                <h2 class="iv-sous-titre">Reportées dans ce navigateur · <span data-champ="nb-reportees-locales">0</span></h2>
                <div class="iv-actions" id="reportees"></div>
            </div>

            <div class="tab-pane fade" id="panneau-traitees" role="tabpanel" aria-labelledby="onglet-traitees" tabindex="0">
                <div class="iv-filtres mt-3">
                    <select class="iv-select" id="f-traitees" aria-label="Filtrer par état">
                        <option value="Terminee">Terminées</option>
                        <option value="Ignoree">Ignorées</option>
                        <option value="Obsolete">Devenues obsolètes</option>
                    </select>
                </div>
                <div class="iv-actions" id="traitees"></div>
            </div>

            <div class="tab-pane fade" id="panneau-continuite" role="tabpanel" aria-labelledby="onglet-continuite" tabindex="0">
                <p class="iv-intro-panneau">Vous serez absent ? Repérez les actions qui ne peuvent pas attendre votre retour et confiez-les temporairement à un collègue. Le prospect reste le vôtre : aucune affectation, autorisation ni commission n'est modifiée.</p>
                <label class="iv-continuite-date" for="c-retour">Je serai de retour le <input type="date" class="iv-champ-date" id="c-retour" /></label>
                <div class="iv-actions" id="continuite"></div>
                <h3 class="iv-sous-titre">Actions confiées à un collègue</h3>
                <div class="iv-actions" id="confiees"></div>
            </div>
        </div>
    </div>
</div>

<partial name="_DonneesModules" model="Model" />

@section Scripts {
    <script src="~/js/prospects-store.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-calcul.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-store.js" asp-append-version="true"></script>
    <script src="~/js/rendezvous-store.js" asp-append-version="true"></script>
    <script src="~/js/transactions-regles.js" asp-append-version="true"></script>
    <script src="~/js/transactions-store.js" asp-append-version="true"></script>
    <script src="~/js/relations-regles.js" asp-append-version="true"></script>
    <script src="~/js/relations-store.js" asp-append-version="true"></script>
    <script src="~/js/annonces-modeles.js" asp-append-version="true"></script>
    <script src="~/js/outils-store.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-matching.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-regles.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-store.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-composants.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-actions.js" asp-append-version="true"></script>
}
