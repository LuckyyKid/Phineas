@using Phineas.Models.ViewModels.Conseiller
@model IntelligencePageViewModel
@{
    ViewData["Title"] = "Recommandations véhicules";
    Layout = "~/Views/Conseiller/_LayoutConseiller.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/prospects.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/soumissions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rendezvous.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/intelligence.css" asp-append-version="true" />
}

<a class="pr-retour" asp-action="Index"><i class="bi bi-arrow-left"></i>Centre d'actions</a>

<header class="sv-head">
    <div>
        <h1>Recommandations véhicules</h1>
        <p class="text-muted mb-0">Compatibilité entre les critères de vos clients et l'inventaire partagé. La compatibilité d'un véhicule n'est pas une probabilité d'achat.</p>
    </div>
</header>

<partial name="~/Views/Prospects/_BandeauDemo.cshtml" />

<div id="matching" data-opportunite="@Model.OpportuniteId" data-vehicule="@Model.VehiculeId">
    <ul class="nav pr-onglets" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" id="onglet-prospect" data-bs-toggle="tab" data-bs-target="#panneau-prospect" type="button" role="tab" aria-controls="panneau-prospect" aria-selected="true">Pour un prospect</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="onglet-vehicule" data-bs-toggle="tab" data-bs-target="#panneau-vehicule" type="button" role="tab" aria-controls="panneau-vehicule" aria-selected="false">Pour un véhicule</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="onglet-demandes" data-bs-toggle="tab" data-bs-target="#panneau-demandes" type="button" role="tab" aria-controls="panneau-demandes" aria-selected="false">Demandes et alertes d'inventaire <span class="pr-compte" data-champ="nb-demandes"></span></button></li>
    </ul>

    <div class="tab-content">
        @* ---------- Mode 1 : véhicules pour un prospect ---------- *@
        <div class="tab-pane fade show active" id="panneau-prospect" role="tabpanel" aria-labelledby="onglet-prospect" tabindex="0">
            <div class="row g-4">
                <div class="col-lg-4">
                    <section class="card" aria-labelledby="titre-criteres">
                        <div class="card-header sv-card-header"><span id="titre-criteres"><i class="bi bi-sliders me-2"></i>Critères du client</span></div>
                        <div class="card-body">
                            <label class="form-label" for="m-opportunite">Opportunité</label>
                            <select class="form-select" id="m-opportunite"></select>
                            <div class="mt-3" data-zone="criteres"></div>
                            <div class="form-check form-switch pr-switch mt-3">
                                <input class="form-check-input" type="checkbox" role="switch" id="m-indisponibles" />
                                <label class="form-check-label" for="m-indisponibles">Afficher aussi les véhicules vendus ou livrés</label>
                            </div>
                            <p class="pr-note mt-3 mb-0"><i class="bi bi-info-circle me-1"></i>Pondérations de démonstration : budget 30 %, catégorie 25 %, caractéristiques 20 %, état/année/kilométrage 15 %, marque 10 %. Un critère inconnu n'est jamais compté comme satisfait.</p>
                        </div>
                    </section>
                </div>
                <div class="col-lg-8">
                    <div class="pr-resultat" id="m-resultat" aria-live="polite"></div>
                    <div class="ia-vehicules" id="m-vehicules"></div>
                </div>
            </div>
        </div>

        @* ---------- Mode 2 : prospects pour un véhicule ---------- *@
        <div class="tab-pane fade" id="panneau-vehicule" role="tabpanel" aria-labelledby="onglet-vehicule" tabindex="0">
            <section class="card">
                <div class="card-body">
                    <label class="form-label" for="v-vehicule">Véhicule de l'inventaire</label>
                    <select class="form-select" id="v-vehicule"></select>
                    <div class="mt-3" data-zone="fiche-vehicule"></div>
                </div>
                <div class="table-responsive">
                    <table class="table pr-table ia-table mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Prospect</th>
                                <th scope="col">Besoin et budget</th>
                                <th scope="col">Compatibilité</th>
                                <th scope="col">Horizon et dernier contact</th>
                                <th scope="col">Conseiller et suivi</th>
                                <th scope="col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody id="v-prospects"></tbody>
                    </table>
                </div>
                <div class="pr-etat-vide" id="v-vide" hidden><i class="bi bi-search"></i><strong>Aucun prospect compatible</strong><span>Aucune opportunité active ne correspond aux caractéristiques de ce véhicule.</span></div>
            </section>
        </div>

        @* ---------- Demandes non satisfaites et alertes d'inventaire ---------- *@
        <div class="tab-pane fade" id="panneau-demandes" role="tabpanel" aria-labelledby="onglet-demandes" tabindex="0">
            <div class="row g-4">
                <div class="col-lg-7">
                    <section class="card" aria-labelledby="titre-demandes">
                        <div class="card-header sv-card-header"><span id="titre-demandes"><i class="bi bi-search-heart me-2"></i>Demandes de recherche</span></div>
                        <div class="card-body" data-zone="demandes"></div>
                    </section>
                </div>
                <div class="col-lg-5 d-flex flex-column gap-4">
                    <section class="card ia-simulation" aria-labelledby="titre-arrivees">
                        <div class="card-header sv-card-header"><span id="titre-arrivees"><i class="bi bi-cone-striped me-2"></i>Arrivées de véhicules</span><span class="badge-soft sv-fictif">Fictif</span></div>
                        <div class="card-body">
                            <p class="small">Simule l'arrivée d'un véhicule dans l'inventaire de cet onglet. Le moteur compare alors les demandes actives et crée, au besoin, une seule recommandation par demande et par véhicule.</p>
                            <div data-zone="arrivees"></div>
                        </div>
                    </section>
                    <section class="card" aria-labelledby="titre-nouvelle-demande">
                        <div class="card-header sv-card-header"><span id="titre-nouvelle-demande"><i class="bi bi-plus-lg me-2"></i>Nouvelle demande</span></div>
                        <form class="card-body" id="form-demande" novalidate>
                            <label class="form-label" for="d-opportunite">Opportunité <span class="pr-requis">*</span></label>
                            <select class="form-select form-select-sm" id="d-opportunite" name="opportunite"></select>
                            <div class="invalid-feedback">Choisissez une opportunité.</div>
                            <div class="row g-2 mt-1">
                                <div class="col-6"><label class="form-label" for="d-categorie">Catégorie</label>
                                    <select class="form-select form-select-sm" id="d-categorie" name="categorie"><option value="">Indifférente</option>
                                        @foreach (var (cle, libelle) in ReferentielsVente.Categories)
                                        {
                                            <option value="@cle">@libelle</option>
                                        }
                                    </select></div>
                                <div class="col-6"><label class="form-label" for="d-budget">Budget maximal</label><input type="number" class="form-control form-control-sm" id="d-budget" name="budget" min="1000" max="300000" step="500" /></div>
                                <div class="col-6"><label class="form-label" for="d-annee">Année minimale</label><input type="number" class="form-control form-control-sm" id="d-annee" name="annee" min="1990" max="2030" /></div>
                                <div class="col-6"><label class="form-label" for="d-km">Kilométrage maximal</label><input type="number" class="form-control form-control-sm" id="d-km" name="km" min="0" max="500000" step="1000" /></div>
                            </div>
                            <fieldset class="mt-2"><legend class="form-label">Critères indispensables</legend>
                                <div class="d-flex flex-wrap gap-3">
                                    <div class="form-check"><input class="form-check-input" type="checkbox" id="d-i-budget" value="budget" name="indispensable" checked /><label class="form-check-label" for="d-i-budget">Budget</label></div>
                                    <div class="form-check"><input class="form-check-input" type="checkbox" id="d-i-categorie" value="categorie" name="indispensable" /><label class="form-check-label" for="d-i-categorie">Catégorie</label></div>
                                </div>
                            </fieldset>
                            <button type="submit" class="btn btn-sm btn-primary mt-3">Enregistrer la demande</button>
                        </form>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_DonneesModules" model="Model" />

@section Scripts {
    <script src="~/js/prospects-store.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-calcul.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-store.js" asp-append-version="true"></script>
    <script src="~/js/rendezvous-store.js" asp-append-version="true"></script>
    <script src="~/js/transactions-regles.js" asp-append-version="true"></script>
    <script src="~/js/transactions-store.js" asp-append-version="true"></script>
    <script src="~/js/relations-regles.js" asp-append-version="true"></script>
    <script src="~/js/relations-store.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-matching.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-regles.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-store.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-composants.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-vehicules.js" asp-append-version="true"></script>
}
