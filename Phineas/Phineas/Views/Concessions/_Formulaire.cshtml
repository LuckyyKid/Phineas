@* Formulaire de création et de modification d'une concession. Styles : .es-formulaire dans wwwroot/css/espaces.css. *@
@model ConcessionFormViewModel

<form asp-action="@(Model.EstModification ? "Modifier" : "Creer")" asp-route-id="@Model.Id" method="post" novalidate class="es-formulaire">
    <div asp-validation-summary="ModelOnly" class="es-alerte es-alerte-erreur"></div>

    <div class="es-champ">
        <label asp-for="Nom"></label>
        <input asp-for="Nom" autofocus />
        <span asp-validation-for="Nom" class="es-erreur"></span>
    </div>

    <div>
        <div class="form-check form-switch es-interrupteur">
            <input asp-for="EstActive" class="form-check-input" role="switch" />
            <label asp-for="EstActive" class="form-check-label"></label>
        </div>
        <p class="es-aide mt-2">Une concession suspendue garde ses données, mais son personnel ne peut plus se connecter.</p>
    </div>

    <div class="es-actions">
        <button type="submit" class="es-btn-sapin">@(Model.EstModification ? "Enregistrer" : "Créer la concession")</button>
        @if (Model.EstModification)
        {
            <a class="es-btn-secondaire" asp-action="Details" asp-route-id="@Model.Id">Annuler</a>
        }
        else
        {
            <a class="es-btn-secondaire" asp-action="Index">Annuler</a>
        }
    </div>
</form>
