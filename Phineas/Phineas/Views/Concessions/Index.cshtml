@* Liste des concessions (administrateur) : en-tête, chiffres, puis la carte du tableau.
   Même présentation que les listes vendeur. Styles : wwwroot/css/espaces.css. *@
@model List<ConcessionResume>
@{
    ViewData["Title"] = "Concessions";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("fr-CA");

    // Chiffres du haut de page, calculés sur la liste affichée.
    int nbActives = 0;
    int nbPersonnel = 0;
    foreach (var c in Model)
    {
        if (c.EstActive)
        {
            nbActives++;
        }
        nbPersonnel += c.NbEmployes;
    }
    int nbSuspendues = Model.Count - nbActives;
}

<div class="es-page">
    <header class="es-entete">
        <div>
            <p class="es-label">Administration</p>
            <h1 class="es-titre">Concessions</h1>
            <p class="es-intro">Toutes les concessions de la plateforme.</p>
        </div>
        <a class="es-btn-sapin" asp-action="Creer"><i class="bi bi-plus-lg" aria-hidden="true"></i>Nouvelle concession</a>
    </header>

    <partial name="_Alertes" />

    <section class="es-chiffres" aria-label="Résumé des concessions">
        <div class="es-verre es-chiffre"><span class="es-chiffre-valeur">@Model.Count</span><span class="es-chiffre-libelle">concessions au total</span></div>
        <div class="es-verre es-chiffre"><span class="es-chiffre-valeur">@nbActives</span><span class="es-chiffre-libelle">actives</span></div>
        <div class="es-verre es-chiffre"><span class="es-chiffre-valeur">@nbSuspendues</span><span class="es-chiffre-libelle">suspendues</span></div>
        <div class="es-verre es-chiffre"><span class="es-chiffre-valeur">@nbPersonnel</span><span class="es-chiffre-libelle">personnes au total</span></div>
    </section>

    <section class="es-verre es-module" aria-label="Liste des concessions">
        @if (Model.Count == 0)
        {
            <div class="es-vide">
                <span class="es-vide-icone" aria-hidden="true"><i class="bi bi-buildings"></i></span>
                <p>Aucune concession pour l'instant.</p>
                <a class="es-btn-sapin" asp-action="Creer">Créer la première</a>
            </div>
        }
        else
        {
            <div class="es-defile">
                <table class="es-table">
                    <thead>
                        <tr>
                            <th>Concession</th>
                            <th class="es-cacher-tablette">Directeur</th>
                            <th class="es-centre">Personnel</th>
                            <th class="es-centre es-cacher-mobile">Véhicules</th>
                            <th>Statut</th>
                            <th class="es-cellule-ouvrir"><span class="visually-hidden">Ouvrir</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>
                                    <a class="es-nom" asp-action="Details" asp-route-id="@c.Id">@c.Nom</a>
                                    <span class="es-sous">Créée le @c.DateCreation.ToLocalTime().ToString("d MMM yyyy", culture)</span>
                                </td>
                                <td class="es-cacher-tablette">@(c.NomDirecteur ?? "Aucun")</td>
                                <td class="es-centre es-chiffre-cellule">@c.NbEmployes</td>
                                <td class="es-centre es-chiffre-cellule es-cacher-mobile">@c.NbVehicules</td>
                                <td>
                                    @if (c.EstActive)
                                    {
                                        <span class="es-statut es-st-ok"><span class="es-statut-point" aria-hidden="true"></span>Active</span>
                                    }
                                    else
                                    {
                                        <span class="es-statut es-st-off"><span class="es-statut-point" aria-hidden="true"></span>Suspendue</span>
                                    }
                                </td>
                                <td class="es-cellule-ouvrir">
                                    <a class="es-ouvrir" asp-action="Details" asp-route-id="@c.Id" aria-label="Ouvrir @c.Nom"><i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
