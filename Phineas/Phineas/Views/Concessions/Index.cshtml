@model List<ConcessionResume>
@{ ViewData["Title"] = "Concessions"; }

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
    <div>
        <h1 class="h3 mb-0">Concessions</h1>
        <div class="text-muted">Toutes les concessions de la plateforme.</div>
    </div>
    <a class="btn btn-primary" asp-action="Creer"><i class="bi bi-plus-lg me-1"></i>Nouvelle concession</a>
</div>

<partial name="_Alertes" />

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-buildings fs-1 d-block mb-2"></i>
            Aucune concession pour l'instant.
            <div class="mt-3"><a class="btn btn-primary btn-sm" asp-action="Creer">Créer la première</a></div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Concession</th>
                        <th class="d-none d-md-table-cell">Directeur</th>
                        <th class="text-center">Personnel</th>
                        <th class="text-center d-none d-sm-table-cell">Véhicules</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                <a class="fw-semibold" asp-action="Details" asp-route-id="@c.Id">@c.Nom</a>
                                <div class="small text-muted">Créée le @c.DateCreation.ToLocalTime().ToString("d MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("fr-CA"))</div>
                            </td>
                            <td class="d-none d-md-table-cell">@(c.NomDirecteur ?? "—")</td>
                            <td class="text-center">@c.NbEmployes</td>
                            <td class="text-center d-none d-sm-table-cell">@c.NbVehicules</td>
                            <td>
                                @if (c.EstActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Suspendue</span>
                                }
                            </td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@c.Id">Ouvrir</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
