@model ConcessionSuppressionViewModel
@{ ViewData["Title"] = "Supprimer la concession"; }

<div class="es-page es-page-etroite">
    <nav class="es-ariane" aria-label="Fil d'Ariane">
        <a asp-action="Index">Concessions</a><i class="bi bi-chevron-right" aria-hidden="true"></i>
        <a asp-action="Details" asp-route-id="@Model.Id">@Model.Nom</a><i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span aria-current="page">Supprimer</span>
    </nav>

    <header class="es-entete">
        <div>
            <p class="es-label">Administration</p>
            <h1 class="es-titre">Supprimer « @Model.Nom »</h1>
        </div>
    </header>

    <section class="es-verre es-carte">
        @if (Model.PeutSupprimer)
        {
            <p>Cette concession n'a ni personnel ni véhicule. La suppression est définitive.</p>
            <form asp-action="Supprimer" asp-route-id="@Model.Id" method="post" class="es-actions">
                <button type="submit" class="es-btn-secondaire es-btn-danger"><i class="bi bi-trash" aria-hidden="true"></i>Supprimer définitivement</button>
                <a class="es-btn-secondaire" asp-action="Details" asp-route-id="@Model.Id">Annuler</a>
            </form>
        }
        else
        {
            <p>
                Impossible de la supprimer : elle a encore
                <strong>@Model.NbEmployes personne(s)</strong> et <strong>@Model.NbVehicules véhicule(s)</strong>.
            </p>
            <p class="es-aide">Retirez-les d'abord, ou suspendez plutôt la concession : ses données sont gardées et son personnel ne peut plus se connecter.</p>
            <div class="es-actions mt-3">
                <a class="es-btn-secondaire" asp-action="Details" asp-route-id="@Model.Id">Retour à la concession</a>
            </div>
        }
    </section>
</div>
