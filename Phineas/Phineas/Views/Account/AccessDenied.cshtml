@using Phineas.Models.Constants
@{
    ViewData["Title"] = "Accès refusé";
    var role = AppRoles.Label(AppRoles.Of(User));
}
<div class="empty-state">
    <span class="empty-icon"><i class="bi bi-sign-stop"></i></span>
    <h1>Accès refusé</h1>
    <p class="text-muted">
        Cette page n'est pas accessible à votre rôle (<strong>@role</strong>).
        C'est normal : chacun ne voit que ce dont son travail a besoin.
    </p>
    <a class="btn btn-primary" asp-controller="Account" asp-action="Home"><i class="bi bi-house me-1"></i>Retour à mon espace</a>
</div>
