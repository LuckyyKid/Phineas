@using System.Text.Json
@using System.Text.Json.Serialization
@using Phineas.Models.ViewModels.Conseiller
@model ChargeTransactions
@{
    // L'encodeur par défaut échappe < > & ' : le JSON est sûr dans une balise <script>.
    // Seuls des états sont transmis : aucun contenu financier confidentiel n'est inclus dans les données de démonstration.
    var options = new JsonSerializerOptions(JsonSerializerDefaults.Web)
    {
        Converters = { new JsonStringEnumConverter() },
    };
    var charge = new
    {
        donnees = Model.Donnees,
        referentiels = ReferentielsTransactions.PourClient(),
        conseillerNom = Model.ConseillerNom,
        urlDetail = Url.Action("Detail", "Transactions", new { id = "__id__" }),
        urlNouvelle = Url.Action("Nouvelle", "Transactions"),
        urlListe = Url.Action("Index", "Transactions"),
    };
}
<script type="application/json" id="transactions-donnees">@Html.Raw(JsonSerializer.Serialize(charge, options))</script>
