@using System.Text.Json
@using System.Text.Json.Serialization
@using Phineas.Models.ViewModels.Conseiller
@model ChargeSoumissions
@{
    // L'encodeur par défaut échappe < > & ' : le JSON est sûr dans une balise <script>.
    var options = new JsonSerializerOptions(JsonSerializerDefaults.Web)
    {
        Converters = { new JsonStringEnumConverter() },
    };
    var charge = new
    {
        donnees = Model.Donnees,
        referentiels = ReferentielsSoumission.PourClient(),
        conseiller = new { nom = Model.ConseillerNom, courriel = Model.ConseillerCourriel },
        concession = Model.Concession,
        urlDetail = Url.Action("Detail", "Soumissions", new { id = "__id__" }),
        urlNouvelle = Url.Action("Nouvelle", "Soumissions"),
        urlListe = Url.Action("Index", "Soumissions"),
    };
}
<script type="application/json" id="soumissions-donnees">@Html.Raw(JsonSerializer.Serialize(charge, options))</script>
