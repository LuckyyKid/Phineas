@* Assistant « Nouvelle soumission » en 3 étapes (client et opportunité, véhicule, offre), puis écran de confirmation.
   Données : prospects et soumissions de démonstration (SoumissionsController.Nouvelle).
   Interactions : wwwroot/js/soumissions-nouvelle.js. Styles : bloc « Nouvelle soumission » de soumissions.css. *@
@using Phineas.Models.ViewModels.Conseiller
@model SoumissionsPageViewModel
@{
    ViewData["Title"] = "Nouvelle soumission";
    Layout = "~/Views/Conseiller/_LayoutConseiller.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/soumissions.css" asp-append-version="true" />
}

<div class="ns-page" id="parcours" data-opportunite="@Model.OpportuniteId" data-prospect="@Model.ProspectId">
    <div class="ns-haut">
        <nav class="ns-ariane" aria-label="Fil d'Ariane">
            <span>Sales OS</span><i class="bi bi-chevron-right" aria-hidden="true"></i><span aria-current="page">Nouvelle soumission</span>
        </nav>
        @* Remplace le bandeau permanent : l'état et la réinitialisation restent accessibles ici (prospects-store.js). *@
        <div class="ns-puces" role="note" title="Prospects, véhicules et montants fictifs. Rien n'est enregistré en base.">
            <span class="ns-chip-demo">Démo</span>
            <span class="ns-demo-etat" data-etat-demo hidden>Modifiée</span>
            <button type="button" class="ns-demo-reset" data-reinitialiser hidden><i class="bi bi-arrow-counterclockwise"></i>Réinitialiser</button>
            <span class="ns-en-ligne"><span class="ns-point-vert" aria-hidden="true"></span>En ligne</span>
        </div>
    </div>

    <a class="ns-retour" asp-action="Index"><i class="bi bi-arrow-left"></i>Soumissions</a>
    <h1 class="ns-titre">Nouvelle soumission</h1>
    <p class="ns-intro">Les informations déjà connues du dossier sont reprises automatiquement.</p>

    <div data-assistant>
        <ol class="ns-etapes" aria-label="Étapes de création">
            <li><button type="button" data-aller="1"><span class="ns-num">1</span>Client et opportunité</button></li>
            <li><button type="button" data-aller="2"><span class="ns-num">2</span>Véhicule</button></li>
            <li><button type="button" data-aller="3"><span class="ns-num">3</span>Offre</button></li>
        </ol>

        @* ---------- Étape 1 : client et opportunité ---------- *@
        <section class="ns-etape ns-deux-cartes" data-etape="1" aria-labelledby="titre-etape-1">
            <h2 class="visually-hidden" id="titre-etape-1">Étape 1 : client et opportunité</h2>
            <div class="ns-verre ns-carte">
                <p class="ns-label">Client</p>
                <div class="ns-recherche">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" id="n-recherche-client" placeholder="Rechercher un prospect" aria-label="Rechercher un prospect" autocomplete="off" />
                </div>
                <div class="ns-clients" role="radiogroup" aria-label="Prospect" data-zone="clients"></div>
            </div>
            <div class="ns-verre ns-carte">
                <p class="ns-label">Opportunité</p>
                <div data-zone="opportunite">
                    <div class="ns-vide"><i class="bi bi-person"></i><span>Choisissez d'abord un prospect.</span></div>
                </div>
            </div>
        </section>

        @* ---------- Étape 2 : véhicule ---------- *@
        <section class="ns-etape" data-etape="2" aria-labelledby="titre-etape-2" hidden>
            <div class="ns-verre ns-carte">
                <div class="ns-question">
                    <h2 id="titre-etape-2">Quel véhicule proposer ?</h2>
                    <span data-zone="pour-client-2"></span>
                </div>
                <div class="ns-recherche ns-recherche-vehicule">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" id="n-recherche-vehicule" placeholder="Marque, modèle, année ou n° d'inventaire" aria-label="Rechercher un véhicule" autocomplete="off" />
                </div>
                <div class="ns-tuiles" role="radiogroup" aria-label="Véhicule" data-zone="vehicules"></div>
                <p class="ns-vide-texte" data-zone="vehicules-vide" hidden>Aucun véhicule ne correspond à cette recherche.</p>
                <nav class="ns-pagination" data-zone="pagination-vehicules" aria-label="Pages de véhicules" hidden></nav>
            </div>
        </section>

        @* ---------- Étape 3 : offre ---------- *@
        <section class="ns-etape" data-etape="3" aria-labelledby="titre-etape-3" hidden>
            <div class="ns-verre ns-carte">
                <div class="ns-question">
                    <h2 id="titre-etape-3">Quelle offre proposer ?</h2>
                    <span data-zone="pour-client-3"></span>
                </div>
                <div class="ns-tuiles ns-tuiles-3" role="radiogroup" aria-label="Offre" data-zone="offres"></div>
                <p class="ns-note">Le détail (options, financement, échange) se règle ensuite dans la fiche de la soumission.</p>
            </div>
        </section>

        <div class="ns-boutons">
            <button type="button" class="ns-btn ns-btn-verre" data-precedent>Précédent</button>
            <button type="button" class="ns-btn ns-btn-sapin" data-suivant disabled>Suivant<i class="bi bi-arrow-right"></i></button>
            <button type="button" class="ns-btn ns-btn-sapin" data-creer disabled hidden>Créer la soumission</button>
            <span class="ns-aide" data-aide aria-live="polite"></span>
        </div>
    </div>

    @* ---------- Écran final ---------- *@
    <section class="ns-fin" data-fin hidden aria-labelledby="titre-fin" tabindex="-1">
        <span class="ns-fin-icone" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
        <h2 class="ns-fin-titre" id="titre-fin">Soumission prête</h2>
        <dl class="ns-fin-recap" data-zone="recap"></dl>
        <div class="ns-fin-boutons">
            <a class="ns-btn ns-btn-blanc" asp-action="Index">Retour : Soumissions</a>
            <a class="ns-btn ns-btn-translucide" href="#" data-ouvrir>Ouvrir la soumission</a>
            <button type="button" class="ns-btn ns-btn-translucide" data-recommencer>Recommencer</button>
        </div>
    </section>
</div>

<partial name="~/Views/Prospects/_DonneesProspects.cshtml" model="new ProspectsPageViewModel { Donnees = Model.Prospects, DonneesFictives = true }" />
<partial name="_DonneesSoumissions" model="new ChargeSoumissions(Model.Soumissions, Model.ConseillerNom, Model.ConseillerCourriel, Model.Concession)" />

@section Scripts {
    <script src="~/js/prospects-store.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-calcul.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-store.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-nouvelle.js" asp-append-version="true"></script>
}
