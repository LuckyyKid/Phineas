@* Formulaire de création et de modification d'un compte. La concession est masquée pour le rôle administrateur
   (script en bas de page). Styles : .es-formulaire dans wwwroot/css/espaces.css. *@
@model UtilisateurFormViewModel

<form asp-action="@(Model.EstModification ? "Modifier" : "Creer")" asp-route-id="@Model.Id" method="post" novalidate class="es-formulaire">
    <div asp-validation-summary="ModelOnly" class="es-alerte es-alerte-erreur"></div>

    <div class="es-grille">
        <div class="es-champ">
            <label asp-for="Prenom"></label>
            <input asp-for="Prenom" autofocus />
            <span asp-validation-for="Prenom" class="es-erreur"></span>
        </div>
        <div class="es-champ">
            <label asp-for="Nom"></label>
            <input asp-for="Nom" />
            <span asp-validation-for="Nom" class="es-erreur"></span>
        </div>
        <div class="es-champ es-pleine-largeur">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" />
            <p class="es-aide">C'est l'identifiant de connexion de la personne.</p>
            <span asp-validation-for="Email" class="es-erreur"></span>
        </div>
        <div class="es-champ">
            <label asp-for="Role"></label>
            <select asp-for="Role" asp-items="Model.Roles" id="choix-role"></select>
            <span asp-validation-for="Role" class="es-erreur"></span>
        </div>
        <div class="es-champ" id="bloc-concession">
            <label asp-for="DealershipId"></label>
            <select asp-for="DealershipId" asp-items="Model.Concessions">
                <option value="">Choisir une concession</option>
            </select>
            <span asp-validation-for="DealershipId" class="es-erreur"></span>
        </div>
    </div>

    @if (!Model.EstModification)
    {
        <div class="es-alerte es-alerte-info mb-0">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <span>Un mot de passe temporaire sera généré et affiché une seule fois. La personne devra le changer à sa première connexion.</span>
        </div>
    }

    <div class="es-actions">
        <button type="submit" class="es-btn-sapin">@(Model.EstModification ? "Enregistrer" : "Créer le compte")</button>
        <a class="es-btn-secondaire" href="javascript:history.back()">Annuler</a>
    </div>
</form>

<script>
    (function () {
        var role = document.getElementById('choix-role');
        var bloc = document.getElementById('bloc-concession');
        function maj() { bloc.style.display = role.value === '@AppRoles.SystemAdmin' ? 'none' : ''; }
        role.addEventListener('change', maj);
        maj();
    })();
</script>
