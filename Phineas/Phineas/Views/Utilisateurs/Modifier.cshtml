@model UtilisateurFormViewModel
@{ ViewData["Title"] = "Modifier une personne"; }

<div class="es-page es-page-etroite">
    <nav class="es-ariane" aria-label="Fil d'Ariane">
        <a asp-action="Index">Personnel</a><i class="bi bi-chevron-right" aria-hidden="true"></i><span aria-current="page">Modifier</span>
    </nav>

    <header class="es-entete">
        <div>
            <p class="es-label">Administration</p>
            <h1 class="es-titre">Modifier @Model.Prenom @Model.Nom</h1>
            <p class="es-intro">Changer le courriel, la concession ou le rôle déconnecte la personne.</p>
        </div>
    </header>

    <section class="es-verre es-carte">
        <partial name="_Formulaire" model="Model" />
    </section>
</div>
