@model UtilisateurFormViewModel
@{ ViewData["Title"] = "Modifier une personne"; }

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Personnel</a></li>
        <li class="breadcrumb-item active">Modifier</li>
    </ol>
</nav>

<h1 class="h3 mb-2">Modifier @Model.Prenom @Model.Nom</h1>
<p class="text-muted mb-4"><i class="bi bi-info-circle me-1"></i>Changer le courriel, la concession ou le rôle déconnecte la personne.</p>

<div class="card" style="max-width: 720px">
    <div class="card-body">
        <partial name="_Formulaire" model="Model" />
    </div>
</div>
