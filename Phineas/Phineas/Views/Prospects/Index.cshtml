@using Phineas.Models.ViewModels.Conseiller
@model ProspectsPageViewModel
@{
    ViewData["Title"] = "Prospects et opportunités";
    Layout = "~/Views/Conseiller/_LayoutConseiller.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/prospects.css" asp-append-version="true" />
}

<header class="sv-head">
    <div>
        <h1>Prospects et opportunités</h1>
        <p class="text-muted mb-0">Vos contacts, leurs projets d'achat et le prochain suivi à effectuer.</p>
    </div>
    <div class="sv-quick">
        <button type="button" class="btn btn-primary btn-sm" data-ouvrir-creation @(Model.OuvrirCreation ? "data-auto" : "")><i class="bi bi-plus-lg me-1"></i>Nouveau prospect</button>
    </div>
</header>

<partial name="_BandeauDemo" />

<section class="card sv-kpis" aria-label="Résumé des prospects">
    <div class="sv-kpi">
        <div class="sv-kpi-label"><i class="bi bi-people"></i>Prospects</div>
        <div class="sv-kpi-value" data-compteur="prospects">—</div>
        <div class="sv-kpi-detail">contacts au total</div>
    </div>
    <div class="sv-kpi">
        <div class="sv-kpi-label"><i class="bi bi-briefcase"></i>Opportunités actives</div>
        <div class="sv-kpi-value" data-compteur="actives">—</div>
        <div class="sv-kpi-detail">hors gagnées et perdues</div>
    </div>
    <div class="sv-kpi">
        <div class="sv-kpi-label"><i class="bi bi-stars"></i>Nouveaux prospects</div>
        <div class="sv-kpi-value" data-compteur="nouveaux">—</div>
        <div class="sv-kpi-detail">ajoutés depuis 7 jours</div>
    </div>
    <div class="sv-kpi sv-ton-attention">
        <div class="sv-kpi-label"><i class="bi bi-alarm"></i>Suivi requis</div>
        <div class="sv-kpi-value" data-compteur="suivis">—</div>
        <div class="sv-kpi-detail">suivi dû ou non planifié</div>
    </div>
</section>

<section class="card pr-module" aria-label="Liste des prospects">
    <div class="pr-toolbar">
        <div class="pr-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" class="form-control" id="f-recherche" placeholder="Rechercher par nom, courriel ou téléphone" aria-label="Rechercher un prospect" autocomplete="off" />
        </div>
        <div class="pr-vues btn-group" role="group" aria-label="Mode d'affichage">
            <input type="radio" class="btn-check" name="vue" id="vue-liste" value="liste" checked />
            <label class="btn btn-sm" for="vue-liste"><i class="bi bi-list-ul me-1"></i>Liste</label>
            <input type="radio" class="btn-check" name="vue" id="vue-pipeline" value="pipeline" />
            <label class="btn btn-sm" for="vue-pipeline"><i class="bi bi-kanban me-1"></i>Pipeline</label>
        </div>
    </div>

    <div class="pr-filtres">
        <select class="form-select form-select-sm" id="f-etape" aria-label="Filtrer par étape">
            <option value="">Toutes les étapes</option>
            @foreach (var e in ReferentielsVente.Etapes)
            {
                <option value="@e">@FormatVente.Libelle(e)</option>
            }
        </select>
        <select class="form-select form-select-sm" id="f-source" aria-label="Filtrer par source">
            <option value="">Toutes les sources</option>
            @foreach (var (cle, libelle) in ReferentielsVente.Sources)
            {
                <option value="@cle">@libelle</option>
            }
        </select>
        <select class="form-select form-select-sm" id="f-conseiller" aria-label="Filtrer par conseiller">
            <option value="">Tous les conseillers</option>
            @foreach (var c in Model.Donnees.Conseillers)
            {
                <option value="@c.Id">@(c.Id == Model.Donnees.ConseillerConnecteId ? "Mes prospects" : c.Nom + " (fictif)")</option>
            }
        </select>
        <select class="form-select form-select-sm" id="f-tri" aria-label="Trier">
            <option value="activite">Activité la plus récente</option>
            <option value="creation">Ajoutés récemment</option>
            <option value="suivi">Prochain suivi</option>
            <option value="nom">Nom (A à Z)</option>
        </select>
        <div class="form-check form-switch pr-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="f-suivi" />
            <label class="form-check-label" for="f-suivi">Suivi requis</label>
        </div>
        <button type="button" class="btn btn-sm btn-link pr-effacer" data-effacer-filtres hidden>Effacer les filtres</button>
    </div>

    <div class="pr-resultat" id="resultat" aria-live="polite"></div>

    <div id="vue-liste-contenu" class="table-responsive">
        <table class="table pr-table mb-0">
            <thead>
                <tr>
                    <th scope="col">Prospect</th>
                    <th scope="col">Source et conseiller</th>
                    <th scope="col">Recherche</th>
                    <th scope="col">Étape</th>
                    <th scope="col">Dernière interaction</th>
                    <th scope="col">Prochaine action</th>
                </tr>
            </thead>
            <tbody id="liste-corps"></tbody>
        </table>
    </div>

    <div id="vue-pipeline-contenu" hidden>
        <div class="pr-pipeline-options">
            <div class="form-check form-switch pr-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="f-clotures" checked />
                <label class="form-check-label" for="f-clotures">Afficher Gagné et Perdu</label>
            </div>
            <span class="small text-muted">Une carte = une opportunité. Faites défiler horizontalement pour voir toutes les étapes.</span>
        </div>
        <div class="pr-board" id="pipeline" role="list" aria-label="Pipeline des opportunités"></div>
    </div>

    <div class="pr-etat-vide" id="etat-vide" hidden>
        <i class="bi bi-search"></i>
        <strong>Aucun résultat</strong>
        <span>Aucun prospect ne correspond à ces critères.</span>
        <button type="button" class="btn btn-sm btn-outline-primary" data-effacer-filtres>Effacer les filtres</button>
    </div>
    <div class="pr-etat-vide" id="etat-aucun" hidden>
        <i class="bi bi-person-plus"></i>
        <strong>Aucun prospect pour l'instant</strong>
        <span>Ajoutez votre premier prospect pour commencer le suivi commercial.</span>
        <button type="button" class="btn btn-sm btn-primary" data-ouvrir-creation>Nouveau prospect</button>
    </div>
</section>

<partial name="_TiroirProspect" model="Model" />
<partial name="_DonneesProspects" model="Model" />

@section Scripts {
    <script src="~/js/prospects-store.js" asp-append-version="true"></script>
    <script src="~/js/prospects-tiroir.js" asp-append-version="true"></script>
    <script src="~/js/prospects-liste.js" asp-append-version="true"></script>
}
