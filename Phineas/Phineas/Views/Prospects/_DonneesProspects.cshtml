@using System.Text.Json
@using System.Text.Json.Serialization
@using Phineas.Models.ViewModels.Conseiller
@model ProspectsPageViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // L'encodeur par défaut échappe < > & ' : le JSON est sûr dans une balise <script>.
    var options = new JsonSerializerOptions(JsonSerializerDefaults.Web)
    {
        Converters = { new JsonStringEnumConverter() },
    };
    var charge = new
    {
        donnees = Model.Donnees,
        referentiels = ReferentielsVente.PourClient(),
        fictives = Model.DonneesFictives,
        urlFiche = Url.Action("Fiche", "Prospects", new { id = "__id__" }),
        urlListe = Url.Action("Index", "Prospects"),
        // Changement d'étape d'une opportunité enregistrée (prospects-store.js, envoyerEtape) : adresse et jeton antiforgery.
        urlChangerEtape = Url.Action("ChangerEtape", "Prospects"),
        // Nouvelle opportunité d'un prospect enregistré (prospects-store.js, envoyerOpportunite ; fonctionnalité 18).
        urlCreerOpportunite = Url.Action("CreerOpportunite", "Prospects"),
        // Qualification d'une opportunité enregistrée (prospects-store.js, envoyerQualification ; fonctionnalité 20).
        urlQualifier = Url.Action("Qualifier", "Prospects"),
        // Véhicules envisagés d'une opportunité enregistrée (prospects-store.js ; fonctionnalité 21).
        urlAjouterVehicule = Url.Action("AjouterVehicule", "Prospects"),
        urlModifierVehicule = Url.Action("ModifierVehicule", "Prospects"),
        urlRetirerVehicule = Url.Action("RetirerVehicule", "Prospects"),
        // Rendez-vous commerciaux d'une opportunité enregistrée (fonctionnalité 22).
        urlPlanifierRendezVous = Url.Action("PlanifierRendezVous", "Prospects"),
        // Cycle de vie de ces rendez-vous (fonctionnalité 23).
        urlModifierRendezVous = Url.Action("ModifierRendezVous", "Prospects"),
        urlReplanifierRendezVous = Url.Action("ReplanifierRendezVous", "Prospects"),
        urlChangerStatutRendezVous = Url.Action("ChangerStatutRendezVous", "Prospects"),
        // « Marquer comme réalisé » d'un suivi enregistré (prospects-store.js, envoyerRealisation).
        urlRealiserSuivi = Url.Action("RealiserSuivi", "Prospects"),
        urlReporterSuivi = Url.Action("ReporterSuivi", "Prospects"),
        jeton = Antiforgery.GetAndStoreTokens(Context).RequestToken,
        // Résultat de ProspectsController.Creer ou Modifier, lu par prospects-tiroir.js (message ou tiroir rouvert avec les erreurs).
        // prospectId rempli : la saisie refusée vient du mode « Modifier » de ce prospect.
        enregistrement = new
        {
            confirmation = Model.Confirmation,
            erreur = Model.Erreur,
            saisie = Model.SaisieRefusee,
            erreurs = Model.ErreursCreation,
            prospectId = Model.ModificationProspectId,
            opportuniteId = Model.ModificationOpportuniteId,
            version = Model.ModificationVersion,
            // Note refusée par ProspectsController.AjouterNote : relue par prospects-fiche.js.
            note = Model.NoteRefusee is null ? null : new { saisie = Model.NoteRefusee, erreurs = Model.ErreursNote },
            // Suivi refusé par ProspectsController.PlanifierSuivi : relu par prospects-fiche.js.
            suivi = Model.SuiviRefuse is null ? null : new { saisie = Model.SuiviRefuse, erreurs = Model.ErreursSuivi },
        },
    };
}
<script type="application/json" id="prospects-donnees">@Html.Raw(JsonSerializer.Serialize(charge, options))</script>
