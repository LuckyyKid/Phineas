@using Phineas.Models.ViewModels.Conseiller
@model RelationsPageViewModel
@{
    ViewData["Title"] = "Ventes perdues";
    Layout = "~/Views/Conseiller/_LayoutConseiller.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/prospects.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rendezvous.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/intelligence.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/relations.css" asp-append-version="true" />
}

<header class="sv-head">
    <div>
        <h1>Ventes perdues</h1>
        <p class="text-muted mb-0">Comprendre pourquoi une opportunité n'a pas abouti, et repérer celles qui pourraient être reprises si la situation change.</p>
    </div>
    <div class="sv-quick">
        <button type="button" class="btn btn-outline-primary btn-sm" data-rc="cloturer"><i class="bi bi-x-octagon me-1"></i>Clôturer une opportunité</button>
        <a class="btn btn-outline-primary btn-sm" asp-action="Statistiques"><i class="bi bi-bar-chart-line me-1"></i>Statistiques</a>
    </div>
</header>

<partial name="~/Views/Prospects/_BandeauDemo.cshtml" />

<div id="pertes" data-opportunite="@Model.OpportuniteId">
    <div data-mode="liste">
        <section class="card sv-kpis rc-kpis" aria-label="Résumé des ventes perdues">
            <div class="sv-kpi"><div class="sv-kpi-label"><i class="bi bi-x-octagon"></i>Perdues</div><div class="sv-kpi-value" data-compteur="perdues">—</div><div class="sv-kpi-detail">opportunités closes</div></div>
            <div class="sv-kpi"><div class="sv-kpi-label"><i class="bi bi-patch-check"></i>Motif connu</div><div class="sv-kpi-value" data-compteur="connus">—</div><div class="sv-kpi-detail" data-detail="hypotheses">confirmés</div></div>
            <div class="sv-kpi sv-ton-attention"><div class="sv-kpi-label"><i class="bi bi-question-circle"></i>Motif inconnu</div><div class="sv-kpi-value" data-compteur="inconnus">—</div><div class="sv-kpi-detail">à ne pas deviner</div></div>
            <div class="sv-kpi"><div class="sv-kpi-label"><i class="bi bi-hourglass"></i>Récupérables</div><div class="sv-kpi-value" data-compteur="recuperables">—</div><div class="sv-kpi-detail">potentiellement</div></div>
            <div class="sv-kpi"><div class="sv-kpi-label"><i class="bi bi-arrow-counterclockwise"></i>Réactivées</div><div class="sv-kpi-value" data-compteur="reactivees">—</div><div class="sv-kpi-detail">par le conseiller</div></div>
            <div class="sv-kpi"><div class="sv-kpi-label"><i class="bi bi-trophy"></i>Récupérées</div><div class="sv-kpi-value" data-compteur="recuperees">—</div><div class="sv-kpi-detail">avec vente livrée</div></div>
        </section>

        <section class="card pr-module" aria-label="Liste des opportunités perdues">
            <div class="pr-toolbar">
                <div class="pr-search">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" class="form-control" id="f-recherche" placeholder="Client, opportunité ou véhicule" aria-label="Rechercher une vente perdue" autocomplete="off" />
                </div>
            </div>
            <div class="pr-filtres">
                <select class="form-select form-select-sm" id="f-periode" aria-label="Filtrer par période de clôture">
                    <option value="">Toutes les périodes</option>
                    <option value="30">30 derniers jours</option>
                    <option value="90">90 derniers jours</option>
                    <option value="365">12 derniers mois</option>
                </select>
                <select class="form-select form-select-sm" id="f-motif" aria-label="Filtrer par motif de perte">
                    <option value="">Tous les motifs</option>
                    @foreach (var (cle, libelle) in ReferentielsRelations.MotifsPerte)
                    {
                        <option value="@cle">@libelle</option>
                    }
                </select>
                <select class="form-select form-select-sm" id="f-origine" aria-label="Filtrer par source du motif">
                    <option value="">Toutes les sources du motif</option>
                    @foreach (var (cle, libelle) in ReferentielsRelations.OriginesMotif)
                    {
                        <option value="@cle">@libelle</option>
                    }
                </select>
                <select class="form-select form-select-sm" id="f-vehicule" aria-label="Filtrer par véhicule recherché">
                    <option value="">Tous les véhicules</option>
                </select>
                <select class="form-select form-select-sm" id="f-conseiller" aria-label="Filtrer par conseiller">
                    @foreach (var c in Model.Prospects.Conseillers)
                    {
                        <option value="@c.Id">@(c.Id == Model.Prospects.ConseillerConnecteId ? "Mes opportunités" : c.Nom + " (fictif)")</option>
                    }
                    <option value="">Tous les conseillers</option>
                </select>
                <select class="form-select form-select-sm" id="f-recuperable" aria-label="Filtrer par possibilité de récupération">
                    <option value="">Récupérables ou non</option>
                    <option value="oui">Potentiellement récupérables</option>
                    <option value="non">Aucune récupération envisagée</option>
                </select>
                <div class="form-check form-switch pr-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="f-reactivees" />
                    <label class="form-check-label" for="f-reactivees">Déjà réactivées</label>
                </div>
                <div class="form-check form-switch pr-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="f-manquantes" />
                    <label class="form-check-label" for="f-manquantes">Informations manquantes</label>
                </div>
                <button type="button" class="btn btn-sm btn-link pr-effacer" data-effacer-filtres hidden>Effacer les filtres</button>
            </div>
            <div class="pr-resultat" id="resultat" aria-live="polite"></div>
            <div class="table-responsive">
                <table class="table pr-table rc-table mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Client et opportunité</th>
                            <th scope="col">Véhicule recherché</th>
                            <th scope="col">Clôture</th>
                            <th scope="col">Motif de perte</th>
                            <th scope="col">Récupération</th>
                            <th scope="col">Prochaine action</th>
                        </tr>
                    </thead>
                    <tbody id="liste-corps"></tbody>
                </table>
            </div>
            <div class="pr-etat-vide" id="etat-vide" hidden>
                <i class="bi bi-emoji-smile"></i>
                <strong>Aucune vente perdue</strong>
                <span data-vide-texte>Aucune opportunité perdue ne correspond à ces critères.</span>
                <button type="button" class="btn btn-sm btn-outline-primary" data-effacer-filtres>Effacer les filtres</button>
            </div>
            <p class="small text-muted px-3 pb-3 mb-0" data-zone="sans-cloture"></p>
            <p class="small text-muted px-3 pb-3 mb-0"><i class="bi bi-info-circle me-1"></i>Aucune probabilité de récupération n'est calculée : une opportunité « récupérable » signifie seulement qu'un événement pourrait justifier une reprise, que vous décidez.</p>
        </section>
    </div>

    <div data-mode="fiche" hidden>
        <p class="mb-3"><a href="@Url.Action("Pertes")" class="small"><i class="bi bi-arrow-left me-1"></i>Toutes les ventes perdues</a></p>
        <div data-zone="fiche"></div>
    </div>
</div>

<partial name="~/Views/Intelligence/_DonneesModules.cshtml" model="Model" />

@section Scripts {
    <script src="~/js/prospects-store.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-calcul.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-store.js" asp-append-version="true"></script>
    <script src="~/js/rendezvous-store.js" asp-append-version="true"></script>
    <script src="~/js/transactions-regles.js" asp-append-version="true"></script>
    <script src="~/js/transactions-store.js" asp-append-version="true"></script>
    <script src="~/js/relations-regles.js" asp-append-version="true"></script>
    <script src="~/js/relations-store.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-matching.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-regles.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-store.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-composants.js" asp-append-version="true"></script>
    <script src="~/js/relations-composants.js" asp-append-version="true"></script>
    <script src="~/js/relations-pertes.js" asp-append-version="true"></script>
}
