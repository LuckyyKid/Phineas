@* Page « Statistiques relationnelles » (maquettes 39 à 41) : trois onglets (ventes perdues, satisfaction, recommandations),
   un seul visible à la fois. Chaque onglet : une phrase de résumé, 3 à 5 chiffres, un ou deux graphiques doux.
   Les chiffres sont calculés dans le navigateur par RelationsClients.statistiques (relations-store.js) ;
   le rendu est fait par wwwroot/js/relations-statistiques.js. Styles : wwwroot/css/relations-statistiques-verre.css. *@
@using Phineas.Models.ViewModels.Conseiller
@model RelationsPageViewModel
@{
    ViewData["Title"] = "Statistiques relationnelles";
    Layout = "~/Views/Conseiller/_LayoutConseiller.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/relations-statistiques-verre.css" asp-append-version="true" />
}

<div class="rs-page" id="statistiques">

    @* Haut propre à cette page (pas de « Modifiée / Réinitialiser » ici : voir la note du bas). *@
    <div class="rs-haut">
        <nav class="rs-ariane" aria-label="Fil d'Ariane">
            <span>Sales OS</span><i class="bi bi-chevron-right" aria-hidden="true"></i><span aria-current="page">Statistiques relationnelles</span>
        </nav>
        <div class="rs-puces" role="note" title="@MentionsDonnees.ModuleSimule">
            <span class="rs-chip-demo">@MentionsDonnees.LibelleSimule</span><span class="visually-hidden">@MentionsDonnees.ModuleSimule</span>
            <span class="rs-en-ligne"><span class="rs-point-vert" aria-hidden="true"></span>En ligne</span>
        </div>
    </div>

    <header class="rs-entete">
        <div>
            <p class="rs-label">Relations clients</p>
            <h1 class="rs-titre">Statistiques relationnelles</h1>
            <p class="rs-intro">Comprendre vos ventes perdues, la satisfaction de vos clients et les résultats de votre réseau.</p>
        </div>
        <label class="rs-periode">
            <i class="bi bi-calendar3" aria-hidden="true"></i>
            <span class="visually-hidden">Période</span>
            <select id="f-periode">
                <option value="30">30 derniers jours</option>
                <option value="90" selected>90 derniers jours</option>
                <option value="365">12 derniers mois</option>
                <option value="">Depuis le début</option>
            </select>
        </label>
    </header>

    <div class="rs-onglets" role="tablist" aria-label="Domaines">
        <button type="button" class="rs-onglet" role="tab" id="onglet-pertes" aria-controls="panneau-pertes" aria-selected="true" data-onglet="pertes">Ventes perdues</button>
        <button type="button" class="rs-onglet" role="tab" id="onglet-satisfaction" aria-controls="panneau-satisfaction" aria-selected="false" tabindex="-1" data-onglet="satisfaction">Satisfaction</button>
        <button type="button" class="rs-onglet" role="tab" id="onglet-recommandations" aria-controls="panneau-recommandations" aria-selected="false" tabindex="-1" data-onglet="recommandations">Recommandations</button>
    </div>

    <section class="rs-panneau" role="tabpanel" id="panneau-pertes" aria-labelledby="onglet-pertes" data-zone="pertes"></section>
    <section class="rs-panneau" role="tabpanel" id="panneau-satisfaction" aria-labelledby="onglet-satisfaction" data-zone="satisfaction" hidden></section>
    <section class="rs-panneau" role="tabpanel" id="panneau-recommandations" aria-labelledby="onglet-recommandations" data-zone="recommandations" hidden></section>

    <p class="rs-note">
        <i class="bi bi-shield-check" aria-hidden="true"></i>
        <span>
            Ce sont des observations, pas des prédictions. Un motif en hypothèse est supposé, pas confirmé, et une information manquante n'est jamais devinée. Données de démonstration.
            @* Affichés par prospects-store.js seulement quand la démonstration a été modifiée. *@
            <span class="rs-demo-etat" data-etat-demo hidden>Données de démonstration modifiées.</span>
            <button type="button" class="rs-demo-reset" data-reinitialiser hidden>Réinitialiser la démo</button>
        </span>
    </p>
</div>

<partial name="~/Views/Intelligence/_DonneesModules.cshtml" model="Model" />

@section Scripts {
    <script src="~/js/prospects-store.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-calcul.js" asp-append-version="true"></script>
    <script src="~/js/soumissions-store.js" asp-append-version="true"></script>
    <script src="~/js/rendezvous-store.js" asp-append-version="true"></script>
    <script src="~/js/transactions-regles.js" asp-append-version="true"></script>
    <script src="~/js/transactions-store.js" asp-append-version="true"></script>
    <script src="~/js/relations-regles.js" asp-append-version="true"></script>
    <script src="~/js/relations-store.js" asp-append-version="true"></script>
    <script src="~/js/annonces-modeles.js" asp-append-version="true"></script>
    <script src="~/js/outils-store.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-matching.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-regles.js" asp-append-version="true"></script>
    <script src="~/js/intelligence-store.js" asp-append-version="true"></script>
    <script src="~/js/relations-statistiques.js" asp-append-version="true"></script>
}
