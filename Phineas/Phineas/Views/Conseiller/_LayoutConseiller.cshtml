@using Phineas.Models.Constants
@using Phineas.Models.ViewModels.Conseiller
@{
    Layout = "_Layout";
    ViewData["ClasseApp"] = "ph-espace";
    var controleur = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool EstActive(EntreeNavigation e) => e.Controleur == controleur && e.Action == action;

    var nomComplet = User.FindFirst(AppClaims.FullName)?.Value ?? User.Identity?.Name ?? "";
    var concession = User.FindFirst(AppClaims.DealershipName)?.Value;
    var initiales = string.Concat(nomComplet.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));
    // Nombre d'actions à traiter, fourni par la page quand elle le connaît (ex. tableau de bord).
    var nbActions = ViewData["NbActions"] as int?;
}

@section Styles {
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="~/css/conseiller.css" asp-append-version="true" />
}

@section Barre {
    <a class="ph-logo" asp-controller="Conseiller" asp-action="Index"><span class="ph-logo-mark" aria-hidden="true"></span>phineas</a>

    <nav class="ph-nav" aria-label="Navigation de l'espace vendeur">
        @foreach (var entree in NavigationVendeur.Menu)
        {
            var compteur = entree.Libelle == "Actions" ? nbActions : null;
            if (entree.Disponible)
            {
                var active = EstActive(entree);
                <a class="@(active ? "is-active" : "")" asp-controller="@entree.Controleur" asp-action="@entree.Action" aria-current="@(active ? "page" : null)">
                    <i class="bi @entree.Icone"></i>@entree.Libelle
                    @if (compteur is not null)
                    {
                        <span class="ph-nav-count">@compteur</span>
                    }
                </a>
            }
            else
            {
                <span class="is-off" aria-disabled="true" title="Disponible avec un prochain module">
                    <i class="bi @entree.Icone"></i>@entree.Libelle
                    @if (compteur is not null)
                    {
                        <span class="ph-nav-count">@compteur</span>
                    }
                </span>
            }
        }
    </nav>

    <div class="ph-user">
        <span class="ph-avatar" aria-hidden="true">@initiales</span>
        <div class="ph-user-id">
            <strong>@nomComplet</strong>
            @if (concession is not null)
            {
                <small>@concession</small>
            }
        </div>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="ph-user-out" title="Se déconnecter" aria-label="Se déconnecter"><i class="bi bi-box-arrow-right"></i></button>
        </form>
    </div>
}

@RenderBody()

<div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3">
    <div id="sv-toast" class="toast align-items-center border-0" role="status" aria-live="polite" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body"><span data-toast-texte></span></div>
            <button type="button" class="btn btn-sm sv-toast-annuler d-none" data-toast-annuler>Annuler</button>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Fermer"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/conseiller.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
