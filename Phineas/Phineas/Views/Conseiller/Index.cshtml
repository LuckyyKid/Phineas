@* Page d'accueil du conseiller : en-tête, 4 chiffres, carte « À faire en premier » et rendez-vous du jour.
   Données : ServiceTableauBordDemo (via ConseillerController.Index). Interactions : wwwroot/js/conseiller.js. Styles : conseiller.css. *@
@using Phineas.Models.ViewModels.Conseiller
@model TableauBordConseillerViewModel
@{
    ViewData["Title"] = "Accueil";
    ViewData["NbActions"] = Model.Actions.Count;
    Layout = "_LayoutConseiller";
    var maintenant = Model.Maintenant;

    // Nombre de priorités montrées dans la carte focus (une seule visible à la fois).
    const int NbPrioritesMax = 3;
    // À partir de cette heure, les rendez-vous restants sont annoncés « ce soir ».
    const int HeureDuSoir = 17;

    // Priorités : échéances du jour qui ne sont pas d'urgence normale, dans l'ordre fourni par le service.
    var priorites = new List<ActionPrioritaire>();
    foreach (var action in Model.Actions)
    {
        if (priorites.Count == NbPrioritesMax)
        {
            break;
        }
        bool urgente = action.Urgence != Urgence.Normale;
        if (action.EcheanceAujourdhui && urgente)
        {
            priorites.Add(action);
        }
    }

    // Rendez-vous encore à venir aujourd'hui, du plus tôt au plus tard.
    var rdvDuJour = new List<RendezVousResume>();
    foreach (var rdv in Model.RendezVous)
    {
        bool aVenir = rdv.Debut >= maintenant;
        bool aujourdhui = rdv.Debut.Date == maintenant.Date;
        if (aVenir && aujourdhui)
        {
            rdvDuJour.Add(rdv);
        }
    }
    rdvDuJour = rdvDuJour.OrderBy(rdv => rdv.Debut).ToList();

    // « ce soir » seulement si tous les rendez-vous restants commencent après HeureDuSoir.
    bool tousLeSoir = rdvDuJour.Count > 0;
    foreach (var rdv in rdvDuJour)
    {
        if (rdv.Debut.Hour < HeureDuSoir)
        {
            tousLeSoir = false;
        }
    }
    string moment = "aujourd'hui";
    if (tousLeSoir)
    {
        moment = "ce soir";
    }

    // Phrase de résumé sous le titre, ex. « 3 priorités aujourd'hui et 4 rendez-vous ce soir. »
    string resume;
    if (priorites.Count == 0)
    {
        resume = "Aucune priorité urgente aujourd'hui";
    }
    else if (priorites.Count == 1)
    {
        resume = "1 priorité aujourd'hui";
    }
    else
    {
        resume = $"{priorites.Count} priorités aujourd'hui";
    }

    if (rdvDuJour.Count == 0)
    {
        resume += " et aucun rendez-vous à venir.";
    }
    else if (rdvDuJour.Count == 1)
    {
        resume += $" et 1 rendez-vous {moment}.";
    }
    else
    {
        resume += $" et {rdvDuJour.Count} rendez-vous {moment}.";
    }

    if (priorites.Count > 0)
    {
        resume += " On commence par la plus urgente.";
    }
}

<header class="ph-head">
    <div>
        <p class="ph-label">@FormatVente.DateDuJour(maintenant)</p>
        <h1 class="ph-hello">Bonjour @Model.Prenom</h1>
        <p class="ph-resume">@resume</p>
    </div>
    <div class="dropdown">
        <button type="button" class="ph-pill" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-plus-lg"></i>Créer</button>
        <ul class="dropdown-menu dropdown-menu-end ph-menu">
            <li><a class="dropdown-item" asp-controller="Prospects" asp-action="Index" asp-route-nouveau="true"><i class="bi bi-person-plus"></i>Prospect</a></li>
            <li><button type="button" class="dropdown-item" data-bientot="La planification arrive avec le module Rendez-vous."><i class="bi bi-calendar-plus"></i>Rendez-vous</button></li>
            <li><button type="button" class="dropdown-item" data-bientot="Les soumissions arrivent avec le module Ventes."><i class="bi bi-file-earmark-plus"></i>Soumission</button></li>
        </ul>
    </div>
</header>

<section class="ph-stats" aria-label="Indicateurs">
    @foreach (var i in Model.Indicateurs)
    {
        <div class="ph-glass ph-stat" title="@i.Detail">
            <span class="ph-stat-value">@i.Valeur</span>
            <span class="ph-stat-label">
                @i.Libelle
                @if (i.Ton == TonIndicateur.Critique && i.Valeur > 0)
                {
                    <span class="ph-dot ph-dot-alerte" role="img" aria-label="à traiter"></span>
                }
            </span>
        </div>
    }
</section>

<div class="ph-grid">
    <section class="ph-focus" id="ph-focus" aria-labelledby="titre-focus" aria-live="polite">
        <div class="ph-focus-top">
            <h2 class="ph-label" id="titre-focus">À faire en premier</h2>
            @if (priorites.Count > 1)
            {
                <span class="ph-steps" aria-hidden="true">
                    @for (var n = 0; n < priorites.Count; n++)
                    {
                        <i data-etape></i>
                    }
                    <span data-position>1/@priorites.Count</span>
                </span>
            }
        </div>

        @for (var n = 0; n < priorites.Count; n++)
        {
            var p = priorites[n];
            <article class="ph-focus-item" data-priorite hidden="@(n > 0)">
                <p class="ph-focus-type">
                    @p.Evenement
                    @if (p.Urgence == Urgence.Critique)
                    {
                        <span class="ph-tag-retard">En retard</span>
                    }
                </p>
                @* Sans ProspectId, la personne n'a pas encore de fiche : le nom reste du texte simple. *@
                @if (p.ProspectId is not null)
                {
                    <h3 class="ph-focus-nom"><a class="sv-lien-fiche" asp-controller="Prospects" asp-action="Fiche" asp-route-id="@p.ProspectId">@p.Prospect</a></h3>
                }
                else
                {
                    <h3 class="ph-focus-nom">@p.Prospect</h3>
                }
                <p class="ph-focus-texte">@p.Motif</p>
                <p class="ph-focus-dossier" data-dossier hidden>
                    <span>@p.Vehicule</span>
                    <span>@FormatVente.Libelle(p.Etape)</span>
                    <span>@FormatVente.Relatif(p.DateEvenement, maintenant)</span>
                </p>
                <div class="ph-focus-actions">
                    <button type="button" class="ph-btn ph-btn-blanc" data-valider>@p.ProchaineAction<i class="bi bi-arrow-right"></i></button>
                    <button type="button" class="ph-btn ph-btn-verre" data-voir-dossier aria-expanded="false">Voir le dossier</button>
                    <button type="button" class="ph-btn-discret" data-plus-tard>Plus tard</button>
                </div>
            </article>
        }

        <div class="ph-focus-fin" data-fin hidden="@(priorites.Count > 0)">
            <h3 class="ph-focus-nom">Tout est réglé</h3>
            <p class="ph-focus-texte">Vos priorités du jour sont traitées. Prenez de l'avance sur vos relances.</p>
        </div>
    </section>

    <section class="ph-glass ph-soir" aria-labelledby="titre-soir">
        <div class="ph-soir-top">
            <h2 class="ph-label" id="titre-soir">@(moment == "ce soir" ? "Ce soir" : "Aujourd'hui")</h2>
            <span class="ph-lien-off" title="Disponible avec le module Rendez-vous">Agenda</span>
        </div>
        @if (rdvDuJour.Count == 0)
        {
            <p class="ph-vide">Plus aucun rendez-vous aujourd'hui.</p>
        }
        else
        {
            <ul class="ph-rdv-liste">
                @foreach (var r in rdvDuJour)
                {
                    <li class="ph-rdv">
                        <time class="ph-rdv-heure" datetime="@r.Debut.ToString("s")">@FormatVente.HeureCourte(r.Debut)</time>
                        <div class="ph-rdv-info">
                            <a class="sv-lien-fiche" asp-controller="Prospects" asp-action="Fiche" asp-route-id="@r.ProspectId"><strong>@r.Client</strong></a>
                            <span>@FormatVente.Libelle(r.Type)@(r.Vehicule is null ? "" : " · " + r.Vehicule)</span>
                        </div>
                        @if (r.Confirme)
                        {
                            <span class="ph-dot ph-dot-ok" role="img" aria-label="Confirmé" title="Confirmé"></span>
                        }
                        else
                        {
                            <span class="ph-a-confirmer">À confirmer</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>
</div>

@if (Model.DonneesFictives)
{
    <p class="ph-note">Données de démonstration · rien n'est enregistré</p>
}
