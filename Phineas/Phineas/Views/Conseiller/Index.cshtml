@using Phineas.Models.ViewModels.Conseiller
@model TableauBordConseillerViewModel
@{
    ViewData["Title"] = "Tableau de bord";
    Layout = "_LayoutConseiller";
    var maintenant = Model.Maintenant;
    var maxPipeline = Model.Pipeline.Count == 0 ? 1 : Math.Max(1, Model.Pipeline.Max(e => e.Nombre));
    var nbAujourdhui = Model.Actions.Count(a => a.EcheanceAujourdhui);
    var nbCritiques = Model.Actions.Count(a => a.Urgence == Urgence.Critique);
}

<header class="sv-head">
    <div>
        <h1>Bonjour @Model.Prenom</h1>
        <div class="sv-head-meta">
            <span><i class="bi bi-person"></i>@Model.NomComplet</span>
            @if (Model.Concession is not null)
            {
                <span><i class="bi bi-buildings"></i>@Model.Concession</span>
            }
            <span><i class="bi bi-calendar3"></i>@FormatVente.DateLongue(maintenant)</span>
        </div>
    </div>
    <div class="sv-quick" role="group" aria-label="Actions rapides">
        <a class="btn btn-primary btn-sm" asp-controller="Prospects" asp-action="Index" asp-route-nouveau="true"><i class="bi bi-person-plus me-1"></i>Nouveau prospect</a>
        <button type="button" class="btn btn-outline-primary btn-sm" data-bientot="La planification des rendez-vous arrive dans une prochaine version."><i class="bi bi-calendar-plus me-1"></i>Rendez-vous</button>
        <button type="button" class="btn btn-outline-primary btn-sm" data-bientot="Les soumissions arrivent dans une prochaine version."><i class="bi bi-file-earmark-plus me-1"></i>Soumission</button>
    </div>
</header>

@if (Model.DonneesFictives)
{
    <div class="sv-demo" role="note">
        <i class="bi bi-cone-striped"></i>
        <div><strong>Données de démonstration.</strong> Les prospects, véhicules, rendez-vous et montants affichés sont fictifs. Les actions ne sont pas enregistrées.</div>
    </div>
}

<section class="card sv-kpis" aria-label="Indicateurs">
    @foreach (var i in Model.Indicateurs)
    {
        <div class="sv-kpi sv-ton-@i.Ton.ToString().ToLowerInvariant()">
            <div class="sv-kpi-label"><i class="bi @i.Icone"></i>@i.Libelle</div>
            <div class="sv-kpi-value">@i.Valeur</div>
            <div class="sv-kpi-detail">
                @if (i.Ton != TonIndicateur.Neutre)
                {
                    <i class="bi @(i.Ton == TonIndicateur.Critique ? "bi-exclamation-octagon-fill" : "bi-exclamation-triangle-fill")"></i>
                }
                @i.Detail
            </div>
        </div>
    }
</section>

<div class="row g-4">
    <div class="col-lg-8 d-flex flex-column gap-4">

        <section class="card" id="sv-priorites" aria-labelledby="titre-priorites">
            <div class="card-header sv-card-header">
                <span id="titre-priorites"><i class="bi bi-lightning-charge me-2"></i>Mes actions prioritaires</span>
                <span class="badge-soft sv-fictif">Fictif</span>
            </div>
            <div class="sv-filtres" role="group" aria-label="Filtrer les actions">
                <button type="button" class="sv-chip is-active" data-filtre="toutes" aria-pressed="true">Toutes <span>@Model.Actions.Count</span></button>
                <button type="button" class="sv-chip" data-filtre="aujourdhui" aria-pressed="false">À faire aujourd'hui <span>@nbAujourdhui</span></button>
                <button type="button" class="sv-chip" data-filtre="critique" aria-pressed="false">Critiques <span>@nbCritiques</span></button>
            </div>

            <ul class="sv-prio-list">
                @foreach (var a in Model.Actions)
                {
                    var (urgLibelle, urgIcone) = FormatVente.Libelle(a.Urgence);
                    <li class="sv-prio sv-urg-@a.Urgence.ToString().ToLowerInvariant()"
                        data-id="@a.Id" data-urgence="@a.Urgence.ToString().ToLowerInvariant()" data-aujourdhui="@(a.EcheanceAujourdhui ? "1" : "0")">
                        <div class="sv-prio-top">
                            <div class="sv-prio-who">
                                <a class="sv-lien-fiche" asp-controller="Prospects" asp-action="Fiche" asp-route-id="@a.ProspectId"><strong>@a.Prospect</strong></a>
                                <span class="sv-prio-vehicule"><i class="bi bi-car-front"></i>@a.Vehicule</span>
                            </div>
                            <div class="sv-prio-tags">
                                <span class="sv-urg-label"><i class="bi @urgIcone"></i>@urgLibelle</span>
                                <span class="status-pill sv-et-@a.Etape">@FormatVente.Libelle(a.Etape)</span>
                            </div>
                        </div>
                        <dl class="sv-prio-body">
                            <div><dt>Événement</dt><dd>@a.Evenement <span class="text-muted">· @FormatVente.Relatif(a.DateEvenement, maintenant)</span></dd></div>
                            <div><dt>Pourquoi maintenant</dt><dd>@a.Motif</dd></div>
                        </dl>
                        <div class="sv-prio-actions">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bientot="Cette action sera disponible avec la gestion des prospects.">
                                <i class="bi @a.IconeAction me-1"></i>@a.ProchaineAction
                            </button>
                            <button type="button" class="btn btn-sm btn-ghost" data-traiter><i class="bi bi-check2 me-1"></i>Marquer comme traité</button>
                        </div>
                    </li>
                }
            </ul>
            <div class="sv-empty d-none" data-vide>
                <i class="bi bi-check2-circle"></i>
                <span>Aucune action dans ce filtre.</span>
            </div>
        </section>
    </div>

    <div class="col-lg-4 d-flex flex-column gap-4">
        <section class="card" aria-labelledby="titre-rdv">
            <div class="card-header sv-card-header">
                <span id="titre-rdv"><i class="bi bi-calendar-event me-2"></i>Rendez-vous à venir</span>
                <span class="badge-soft sv-fictif">Fictif</span>
            </div>
            @if (Model.RendezVous.Count == 0)
            {
                <div class="sv-empty"><i class="bi bi-calendar"></i><span>Aucun rendez-vous prévu.</span></div>
            }
            else
            {
                <div class="sv-rdv-list">
                    @foreach (var jour in Model.RendezVous.OrderBy(r => r.Debut).GroupBy(r => r.Debut.Date))
                    {
                        <div class="sv-rdv-day">@FormatVente.Jour(jour.Key, maintenant)</div>
                        @foreach (var r in jour)
                        {
                            var passe = r.Debut < maintenant;
                            <div class="sv-rdv @(passe ? "is-past" : "")">
                                <time class="sv-rdv-time" datetime="@r.Debut.ToString("s")">@FormatVente.Heure(r.Debut)</time>
                                <div class="sv-rdv-info">
                                    <a class="sv-lien-fiche" asp-controller="Prospects" asp-action="Fiche" asp-route-id="@r.ProspectId"><strong>@r.Client</strong></a>
                                    <span>@r.Vehicule</span>
                                    <span class="sv-rdv-meta">
                                        <span class="badge-soft">@FormatVente.Libelle(r.Type)</span>
                                        @if (passe)
                                        {
                                            <span class="text-muted small">Passé</span>
                                        }
                                        else if (r.Confirme)
                                        {
                                            <span class="sv-ok"><i class="bi bi-check-circle-fill"></i>Confirmé</span>
                                        }
                                        else
                                        {
                                            <span class="sv-warn"><i class="bi bi-question-circle-fill"></i>À confirmer</span>
                                        }
                                    </span>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </section>

        <section class="card" id="sv-alertes" aria-labelledby="titre-alertes">
            <div class="card-header sv-card-header">
                <span id="titre-alertes"><i class="bi bi-bell me-2"></i>Ce qui bloque mes ventes</span>
                <span class="badge-soft sv-fictif">Fictif</span>
            </div>
            <ul class="sv-alert-list">
                @foreach (var al in Model.Alertes)
                {
                    var (typeLibelle, typeIcone) = FormatVente.Libelle(al.Type);
                    <li class="sv-alert sv-al-@al.Type" data-alerte="@al.Id">
                        <span class="sv-alert-icon"><i class="bi @typeIcone"></i></span>
                        <div class="sv-alert-body">
                            <span class="sv-alert-type">@typeLibelle · @FormatVente.Relatif(al.Date, maintenant)</span>
                            <strong>@al.Titre</strong>
                            <span>@al.Detail</span>
                        </div>
                        <button type="button" class="btn-close sv-alert-close" data-ignorer aria-label="Masquer l'alerte : @al.Titre"></button>
                    </li>
                }
            </ul>
            <div class="sv-empty d-none" data-vide>
                <i class="bi bi-check2-circle"></i>
                <span>Aucun blocage pour le moment.</span>
            </div>
        </section>
    </div>

    <div class="col-12">
        <section class="card" aria-labelledby="titre-pipeline">
            <div class="card-header sv-card-header">
                <span id="titre-pipeline"><i class="bi bi-funnel me-2"></i>Mon pipeline</span>
                <span class="badge-soft sv-fictif">Fictif</span>
            </div>
            <div class="card-body">
                <table class="sv-pipeline">
                    <caption class="visually-hidden">Opportunités en cours par étape, nombre et valeur</caption>
                    <thead class="visually-hidden">
                        <tr><th scope="col">Étape</th><th scope="col">Répartition</th><th scope="col">Opportunités</th><th scope="col">Valeur</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Pipeline)
                        {
                            var pct = e.Nombre * 100 / maxPipeline;
                            <tr title="@FormatVente.Libelle(e.Etape) : @e.Nombre opportunité(s), @FormatVente.Argent(e.Valeur)">
                                <th scope="row">@FormatVente.Libelle(e.Etape)</th>
                                <td class="sv-bar-cell"><span class="sv-bar" style="width:@(pct)%"></span></td>
                                <td class="sv-num">@e.Nombre</td>
                                <td class="sv-money">@FormatVente.Argent(e.Valeur)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="sv-closed">
                    <span class="text-muted">Clôturés ce mois-ci</span>
                    <span class="sv-closed-item"><i class="bi bi-trophy"></i>@Model.Gagnes gagnés</span>
                    <span class="sv-closed-item is-lost"><i class="bi bi-x-circle"></i>@Model.Perdus perdus</span>
                </div>
            </div>
        </section>
    </div>

</div>
