@using Phineas.Models.ViewModels.Conseiller
@model TableauBordConseillerViewModel
@{
    ViewData["Title"] = "Tableau de bord";
    Layout = "_LayoutConseiller";
    var maintenant = Model.Maintenant;
    var maxPipeline = Model.Pipeline.Count == 0 ? 1 : Math.Max(1, Model.Pipeline.Max(e => e.Nombre));
}

@section Styles {
    <link rel="stylesheet" href="~/css/transactions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/intelligence.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/relations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/outils.css" asp-append-version="true" />
}

<header class="sv-head">
    <div>
        <h1>Bonjour @Model.Prenom</h1>
        <div class="sv-head-meta">
            <span><i class="bi bi-person"></i>@Model.NomComplet</span>
            @if (Model.Concession is not null)
            {
                <span><i class="bi bi-buildings"></i>@Model.Concession</span>
            }
            <span><i class="bi bi-calendar3"></i>@FormatVente.DateLongue(maintenant)</span>
        </div>
    </div>
    <div class="sv-quick" role="group" aria-label="Actions rapides">
        <a class="btn btn-primary btn-sm" asp-controller="Prospects" asp-action="Index" asp-route-nouveau="true"><i class="bi bi-person-plus me-1"></i>Nouveau prospect</a>
        <a class="btn btn-outline-primary btn-sm" asp-controller="RendezVous" asp-action="Nouveau"><i class="bi bi-calendar-plus me-1"></i>Rendez-vous</a>
        <a class="btn btn-outline-primary btn-sm" asp-controller="Soumissions" asp-action="Nouvelle"><i class="bi bi-file-earmark-plus me-1"></i>Soumission</a>
        <a class="btn btn-outline-primary btn-sm" asp-controller="Transactions" asp-action="Nouvelle"><i class="bi bi-cash-coin me-1"></i>Transaction</a>
    </div>
</header>

@if (Model.DonneesFictives)
{
    <div class="sv-demo" role="note">
        <i class="bi bi-cone-striped"></i>
        <div><strong>Données de démonstration.</strong> Les prospects, véhicules, rendez-vous et montants affichés sont fictifs. Les actions ne sont pas enregistrées.</div>
    </div>
}

<section class="card sv-kpis" aria-label="Indicateurs">
    @foreach (var i in Model.Indicateurs)
    {
        <div class="sv-kpi sv-ton-@i.Ton.ToString().ToLowerInvariant()">
            <div class="sv-kpi-label"><i class="bi @i.Icone"></i>@i.Libelle</div>
            <div class="sv-kpi-value" data-indicateur="@i.Icone">@(i.Valeur?.ToString() ?? "—")</div>
            <div class="sv-kpi-detail">
                @if (i.Ton != TonIndicateur.Neutre)
                {
                    <i class="bi @(i.Ton == TonIndicateur.Critique ? "bi-exclamation-octagon-fill" : "bi-exclamation-triangle-fill")"></i>
                }
                @i.Detail
            </div>
        </div>
    }
</section>

<div class="row g-4">
    <div class="col-lg-8 d-flex flex-column gap-4">

        @* Rendu par intelligence-tableau.js à partir du moteur d'intelligence commerciale (même source que le Centre d'actions). *@
        <section class="card" id="ia-priorites" aria-labelledby="titre-priorites">
            <div class="card-header sv-card-header">
                <span id="titre-priorites"><i class="bi bi-lightning-charge me-2"></i>Mes actions prioritaires</span>
                <a class="btn btn-sm btn-link p-0" asp-controller="Intelligence" asp-action="Index">Centre d'actions</a>
            </div>
            <div class="sv-filtres" role="group" aria-label="Filtrer les actions">
                <button type="button" class="sv-chip is-active" data-ia-filtre="toutes" aria-pressed="true">Toutes <span>—</span></button>
                <button type="button" class="sv-chip" data-ia-filtre="aujourdhui" aria-pressed="false">À faire aujourd'hui <span>—</span></button>
                <button type="button" class="sv-chip" data-ia-filtre="urgentes" aria-pressed="false">Urgentes <span>—</span></button>
            </div>
            <div data-ia-zone>
                <div class="sv-empty"><i class="bi bi-hourglass"></i><span>Chargement des actions…</span></div>
            </div>
        </section>

        @* Relations clients (phase 07) : compteurs lus dans le moteur partagé (relations-liens.js). *@
        <section class="card" id="rc-relations" aria-labelledby="titre-relations">
            <div class="card-header sv-card-header">
                <span id="titre-relations"><i class="bi bi-people me-2"></i>Relations clients</span>
                <a class="btn btn-sm btn-link p-0" asp-controller="Relations" asp-action="Satisfaction">Après-vente</a>
            </div>
            <div class="card-body" data-rc-zone>
                <div class="sv-empty"><i class="bi bi-hourglass"></i><span>Chargement…</span></div>
            </div>
        </section>

        @* Outils du vendeur (phase 08) : accès rapides et indicateurs essentiels, calculés par performances-calcul.js. *@
        <section class="card" id="ov-outils" aria-labelledby="titre-outils">
            <div class="card-header sv-card-header">
                <span id="titre-outils"><i class="bi bi-grid me-2"></i>Mes outils</span>
                <a class="btn btn-sm btn-link p-0" asp-controller="Outils" asp-action="Performances">Mes performances</a>
            </div>
            <div class="card-body" data-ov-zone>
                <div class="sv-empty"><i class="bi bi-hourglass"></i><span>Chargement…</span></div>
            </div>
        </section>
    </div>

    <div class="col-lg-4 d-flex flex-column gap-4">
        <section class="card" aria-labelledby="titre-rdv">
            <div class="card-header sv-card-header">
                <span id="titre-rdv"><i class="bi bi-calendar-event me-2"></i>Rendez-vous à venir</span>
                <a class="btn btn-sm btn-link p-0" asp-controller="RendezVous" asp-action="Index">Voir l'agenda</a>
            </div>
            @* Rendu serveur à partir des mêmes données que l'agenda, puis rafraîchi depuis l'état local (rendezvous-tableau.js). *@
            <div data-rdv-tableau>
                @if (Model.RendezVous.Count == 0)
                {
                    <div class="sv-empty"><i class="bi bi-calendar"></i><span>Aucun rendez-vous prévu.</span></div>
                }
                else
                {
                    <div class="sv-rdv-list">
                        @foreach (var jour in Model.RendezVous.OrderBy(r => r.Debut).GroupBy(r => r.Debut.Date))
                        {
                            <div class="sv-rdv-day">@FormatVente.Jour(jour.Key, maintenant)</div>
                            @foreach (var r in jour)
                            {
                                <div class="sv-rdv">
                                    <time class="sv-rdv-time" datetime="@r.Debut.ToString("s")">@FormatVente.Heure(r.Debut)</time>
                                    <div class="sv-rdv-info">
                                        <a class="sv-lien-fiche" asp-controller="RendezVous" asp-action="Detail" asp-route-id="@r.Id"><strong>@r.Client</strong></a>
                                        @if (r.Vehicule is not null)
                                        {
                                            <span>@r.Vehicule</span>
                                        }
                                        <span class="sv-rdv-meta">
                                            <span class="badge-soft">@ReferentielsRendezVous.Libelle(r.Type)</span>
                                            @if (r.Statut == StatutRendezVous.Confirme)
                                            {
                                                <span class="sv-ok"><i class="bi bi-check-circle-fill"></i>Confirmé</span>
                                            }
                                            else
                                            {
                                                <span class="sv-warn"><i class="bi bi-question-circle-fill"></i>@ReferentielsRendezVous.Libelle(r.Statut)</span>
                                            }
                                        </span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </section>

        @* Rendu par transactions-tableau.js à partir de l'état local des transactions (même source que le module). *@
        <section class="card" aria-labelledby="titre-transactions" data-trx-tableau>
            <div class="card-header sv-card-header">
                <span id="titre-transactions"><i class="bi bi-cash-coin me-2"></i>Mes transactions</span>
                <a class="btn btn-sm btn-link p-0" asp-controller="Transactions" asp-action="Index">Voir les transactions</a>
            </div>
            <div data-trx-zone>
                <div class="sv-empty"><i class="bi bi-hourglass"></i><span>Chargement des transactions…</span></div>
            </div>
        </section>

        <section class="card" id="sv-alertes" aria-labelledby="titre-alertes">
            <div class="card-header sv-card-header">
                <span id="titre-alertes"><i class="bi bi-bell me-2"></i>Ce qui bloque mes ventes</span>
                <span class="badge-soft sv-fictif">Fictif</span>
            </div>
            <ul class="sv-alert-list">
                <li hidden data-trx-alertes></li>
                @foreach (var al in Model.Alertes)
                {
                    var (typeLibelle, typeIcone) = FormatVente.Libelle(al.Type);
                    <li class="sv-alert sv-al-@al.Type" data-alerte="@al.Id" data-rdv-alerte="@al.RendezVousId">
                        <span class="sv-alert-icon"><i class="bi @typeIcone"></i></span>
                        <div class="sv-alert-body">
                            <span class="sv-alert-type">@typeLibelle · @FormatVente.Relatif(al.Date, maintenant)</span>
                            <strong>@al.Titre</strong>
                            <span>@al.Detail</span>
                        </div>
                        <button type="button" class="btn-close sv-alert-close" data-ignorer aria-label="Masquer l'alerte : @al.Titre"></button>
                    </li>
                }
            </ul>
            <div class="sv-empty d-none" data-vide>
                <i class="bi bi-check2-circle"></i>
                <span>Aucun blocage pour le moment.</span>
            </div>
        </section>
    </div>

    <div class="col-12">
        <section class="card" aria-labelledby="titre-pipeline">
            <div class="card-header sv-card-header">
                <span id="titre-pipeline"><i class="bi bi-funnel me-2"></i>Mon pipeline</span>
                <span class="badge-soft sv-fictif">Fictif</span>
            </div>
            <div class="card-body">
                <table class="sv-pipeline">
                    <caption class="visually-hidden">Opportunités en cours par étape, nombre et valeur</caption>
                    <thead class="visually-hidden">
                        <tr><th scope="col">Étape</th><th scope="col">Répartition</th><th scope="col">Opportunités</th><th scope="col">Valeur</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Pipeline)
                        {
                            var pct = e.Nombre * 100 / maxPipeline;
                            <tr title="@FormatVente.Libelle(e.Etape) : @e.Nombre opportunité(s), @FormatVente.Argent(e.Valeur)">
                                <th scope="row">@FormatVente.Libelle(e.Etape)</th>
                                <td class="sv-bar-cell"><span class="sv-bar" style="width:@(pct)%"></span></td>
                                <td class="sv-num">@e.Nombre</td>
                                <td class="sv-money">@FormatVente.Argent(e.Valeur)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="sv-closed">
                    <span class="text-muted">Clôturés ce mois-ci</span>
                    <span class="sv-closed-item"><i class="bi bi-trophy"></i>@Model.Gagnes gagnés</span>
                    <span class="sv-closed-item is-lost"><i class="bi bi-x-circle"></i>@Model.Perdus perdus</span>
                </div>
            </div>
        </section>
    </div>

</div>

@if (Model.Agenda is not null)
{
    <partial name="~/Views/RendezVous/_DonneesModules.cshtml" model="Model.Agenda" />
    @if (Model.Transactions is not null)
    {
        <partial name="~/Views/Transactions/_DonneesTransactions.cshtml" model="new ChargeTransactions(Model.Transactions, Model.Agenda.ConseillerNom)" />
        @if (Model.Intelligence is not null)
        {
            <partial name="~/Views/Intelligence/_DonneesIntelligence.cshtml" model="new ChargeIntelligence(Model.Intelligence, Model.Agenda.ConseillerNom)" />
        }
    }
}

@section Scripts {
    @if (Model.Agenda is not null)
    {
        <script src="~/js/prospects-store.js" asp-append-version="true"></script>
        <script src="~/js/soumissions-store.js" asp-append-version="true"></script>
        <script src="~/js/rendezvous-store.js" asp-append-version="true"></script>
        <script src="~/js/rendezvous-composants.js" asp-append-version="true"></script>
        <script src="~/js/rendezvous-tableau.js" asp-append-version="true"></script>
        @if (Model.Transactions is not null)
        {
            <script src="~/js/soumissions-calcul.js" asp-append-version="true"></script>
            <script src="~/js/transactions-regles.js" asp-append-version="true"></script>
            <script src="~/js/transactions-store.js" asp-append-version="true"></script>
            <script src="~/js/transactions-composants.js" asp-append-version="true"></script>
            <script src="~/js/transactions-tableau.js" asp-append-version="true"></script>
            @if (Model.Intelligence is not null)
            {
                <script src="~/js/relations-regles.js" asp-append-version="true"></script>
                <script src="~/js/relations-store.js" asp-append-version="true"></script>
                <script src="~/js/annonces-modeles.js" asp-append-version="true"></script>
                <script src="~/js/outils-store.js" asp-append-version="true"></script>
                <script src="~/js/intelligence-matching.js" asp-append-version="true"></script>
                <script src="~/js/intelligence-regles.js" asp-append-version="true"></script>
                <script src="~/js/intelligence-store.js" asp-append-version="true"></script>
                <script src="~/js/intelligence-composants.js" asp-append-version="true"></script>
                <script src="~/js/intelligence-tableau.js" asp-append-version="true"></script>
                <script src="~/js/relations-liens.js" asp-append-version="true"></script>
                <script src="~/js/performances-calcul.js" asp-append-version="true"></script>
                <script src="~/js/outils-liens.js" asp-append-version="true"></script>
            }
        }
    }
}
